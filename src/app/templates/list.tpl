<div class="spinner">
    <div class="loading-container">
        <div class="ball"></div>
        <div class="ball1"></div>
    </div>
</div>
<div class="browser-hero">
    <div class="browser-hero-backdrop"></div>
    <div class="browser-hero-shade"></div>
    <div class="browser-hero-content">
        <div class="browser-hero-title"><%= i18n.__("Find your next watch") %></div>
        <div class="browser-hero-meta">
            <span class="browser-hero-rating"></span>
            <span class="browser-hero-year"></span>
            <span class="browser-hero-quality">4K Ultra HD</span>
        </div>
        <div class="browser-hero-copy"><%= i18n.__("Browse movies and shows with a cleaner, cinematic layout.") %></div>
        <div class="browser-hero-actions">
            <button class="browser-hero-play"><i class="fa fa-play"></i><%= i18n.__("Watch Now") %></button>
            <button class="browser-hero-detail"><i class="fa fa-info-circle"></i><%= i18n.__("Details") %></button>
        </div>
    </div>
    <div class="browser-hero-dots"></div>
    <button class="browser-hero-next"><i class="fa fa-chevron-right"></i></button>
</div>
<div class="content-section-header">
    <h2><%= i18n.__("Popular Now") %></h2>
</div>
<div class="items"></div>
