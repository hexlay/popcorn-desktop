.settings-container-contain
    z-index 1
    background-color $BgColor1
    background-image radial-gradient(circle at 18% 0%, rgba(244,185,66,0.14), transparent 34%), radial-gradient(circle at 82% 8%, rgba(58,92,164,0.18), transparent 38%), linear-gradient(180deg, rgba(255,255,255,0.035), transparent 260px)
    height 100%
    width calc(100% - 5px)
    position fixed
    scrollable()
    padding-top $TitleHeight + 28px
    &::-webkit-scrollbar-track
        margin-top $TitleHeight
        margin-bottom 5px

    .settings-container
        z-index 1
        width calc(100% - 72px)
        max-width 1180px
        height auto
        position absolute
        left 0
        right 0
        margin-left auto
        margin-right auto
        background-color transparent
        -webkit-user-select none
        padding-bottom 38px
        animation appSurfaceEnter $AppMotionNormal $AppMotionEase both

        section
            display flex
            flex-direction row
            justify-content flex-start
            flex-flow row wrap
            width 100%
            margin 0 auto 18px
            position relative
            box-sizing border-box
            overflow hidden
            padding 22px 26px 24px
            border 1px solid rgba(255,255,255,0.10)
            border-radius 18px
            background rgba(255,255,255,0.055)
            box-shadow 0 22px 56px rgba(0,0,0,0.26), inset 0 1px 0 rgba(255,255,255,0.06)

            .title
                padding-top 3px
                color $SettingsCategoriesText
                font-family $Font, $AlternateFont
                font-size 16px
                width 178px
                margin-right 26px
                position relative
                border-right 1px solid rgba(255,255,255,0.10)
                line-height 1.3

            .content
                position relative
                padding-top 0
                padding-left 0
                float right
                width calc(100% - 204px)
                min-width 0
                height 100%
                color $SettingsText1
                font-family $Font, $AlternateFont
                font-size 13px
                border-bottom 0

                span
                    float left
                    width 100%
                    min-height 40px
                    height auto
                    margin-bottom 8px
                    display flex
                    align-items center
                    flex-wrap wrap
                    gap 8px 0
                    min-width 0

                    &:last-child
                        margin-bottom 0

                    p
                        flex 0 0 210px
                        min-width 210px
                        max-width 210px
                        color $SettingsText1
                        font-family $Font, $AlternateFont
                        font-size 13px
                        float left
                        margin 0
                        line-height 1.35

                    em
                        color $SettingsText2
                        font-size 12px
                        line-height 1.45
                        min-width 0
                        white-space normal

                    #downloadsDir,
                    #protocolEnc
                        &:hover + em
                            opacity 1

                        + em
                            padding-left 14px
                            cursor default
                            opacity 0
                            transition opacity 200ms ease

                            &:hover
                                opacity 0

        .modal-overlay
            display none
            position fixed
            top 0
            left 0
            height 100%
            width 100%
            background-color rgba(0,0,0,0.5)
            z-index 99998

        .modal-content
            display none
            position fixed
            width 360px
            top 35%
            left 50%
            margin-left -180px
            background-color $BgColor2
            -webkit-border-radius 5px
            border-radius 5px
            border 1px solid $BgColor2
            padding 20px 20px 15px
            z-index 99999
            .modal-close
                color #000
                cursor pointer
                position absolute
                top -11px
                right -10px
                background white
                border-radius 51px
                padding 0
                width 21px
                height 21px


            #qrcode
                margin 0 59px 3px
                background-color #fff
                border-radius 5px

        .poster_size > select
            width 62px

        #title
            padding 0
            margin -2px 0 16px
            border 0
            background transparent
            box-shadow none
            -webkit-backdrop-filter none
            backdrop-filter none
            justify-content space-between
            align-items center
            min-height 40px

            .title
                display flex
                align-items center
                width auto
                margin 0 auto 0 2px
                padding 0
                border 0
                color $Text1
                font-family $MainFontBold, $AlternateFont
                font-size 15px
                line-height 38px

            .content
                width auto
                padding-top 0
                height 38px
                border-bottom 1px solid transparent
                display flex
                justify-content flex-end
                margin-left auto
                margin-right 48px

                label
                    margin-top -7px

                span
                    width auto
                    min-height 38px
                    margin-bottom 0
                    display flex
                    align-items center

                .keyboard,.help,.about
                    font-size 18px
                    margin 0 0 0 10px
                    padding 0
                    width 38px
                    height 38px
                    line-height 38px
                    border-radius 50%
                    color rgba(255,255,255,0.72)
                    background rgba(255,255,255,0.07)
                    border 1px solid rgba(255,255,255,0.09)
                    cursor pointer
                    display inline-flex
                    align-items center
                    justify-content center
                    box-sizing border-box
                    text-align center
                    transition color 180ms ease, background-color 180ms ease, transform 180ms ease
                    -webkit-backdrop-filter blur(16px) saturate(145%)
                    backdrop-filter blur(16px) saturate(145%)

                    &:hover
                        color #fff
                        background rgba(255,255,255,0.13)
                        transform translateY(-1px)

        #user-interface
            .subtitles-language > select,
            .start-screen > select,
            .watchedCovers > select,
            .defaultFilters > select,
            .tv_detail_jump_to > select
                width 220px

            .UITransparency > label
                float left
                margin 0 6px 0 18px

        #localisation
            .subtitles-language > select,
            .translateTitle > select
                width 220px

            label#contentLangOnly
                margin-left 16px

        #subtitles
            .subtitles-language-default > select,
            .subtitles-font > select,
            .subtitles-decoration > select
                width 220px

            .subtitles-size > select
                width 62px

            .subtitles-custom > .settings-label
                margin-left 40px

            .subtitles-custom
                .colorsub
                    cursor pointer

        #features
            .trakt-options
                color $SettingsText1
                display inline-flex
                margin-left 20px

                a
                    display inline-block

                .unauthtext,
                .syncTrakt
                    color $ButtonBgActive
                    &:hover
                        color $ButtonBgHover

        #tvshowtime
            .tvshowtime-options
                margin-bottom 35px

                a
                    display inline-block

                .unauthtext
                    margin-left 5px
                    color $ButtonBgActive
                    &:hover
                        color $ButtonBgHover

                #connect-with-tvst
                    margin-top -12px

                .tvst-loading-spinner
                    animation-duration 0.75s
                    animation-iteration-count infinite
                    animation-name rotate-forever
                    animation-timing-function linear
                    width 15px
                    height 15px
                    border 3px solid #2d75df
                    border-right-color transparent
                    border-radius 50%
                    display inline-flex
                    position absolute
                    left 0
                    margin-left 20px
                    margin-top -2px

        #subtitles
            .opensubtitles-options
                color $SettingsText1

                a
                    display inline-block

                .unauthtext
                    margin-left 5px
                    color $ButtonBgActive
                    &:hover
                        color $ButtonBgHover

                .loading-spinner
                    animation-duration 0.75s
                    animation-iteration-count infinite
                    animation-name rotate-forever
                    animation-timing-function linear
                    width 20px
                    height 20px
                    border 4px solid #2d75df
                    border-right-color transparent
                    border-radius 50%
                    display inline-flex
                    margin-left -27px
                    margin-top -9px

                .invalid-cross
                    width 20px
                    height 20px
                    display inline-flex
                    margin-left -27px

                    &:before
                        content "\2573"
                        font-family Arial
                        font-size 12px
                        font-weight bolder
                        text-shadow 0 0 10px #EE3030
                        color #EE3030

                .valid-tick
                    width 20px
                    height 20px
                    display inline-flex
                    margin-left -27px
                    margin-top -9px

                    &:before
                        content "\2714"
                        font-family Arial
                        font-size 17px
                        font-weight bold
                        text-shadow 0 0 10px #4EEE30
                        color #4EEE30
                        position relative
                        top 2px

                .syncOpensubtitles,
                .createOpensubtitles
                    color $ButtonBgActive

                    &:hover
                        color $ButtonBgHover

        #remote-control
            .content
                .qr-code
                    font-size 15px
                    margin -3px -3px -3px 155px
                    padding 3px
                    border-radius 50%
                    vertical-align middle
                    cursor pointer
                    transition all .5s

                    &:hover
                        color $ButtonBgActive

                #settingsIpAddr, #httpApiPort, #httpApiUsername, #httpApiPassword
                    width 260px

        #apiserver,
        #miscellaneous
            input
                text-overflow ellipsis

        #apiserver
            .opensubtitles-options
                display flex
                align-items center
                width 100%

                input
                    width calc(100% - 220px)
                    max-width 650px

            .valid-tick
                width 20px
                height 20px
                display inline-flex
                line-height 12px

                &:before
                    content "\2714"
                    font-family Arial
                    font-size 17px
                    font-weight bold
                    text-shadow 0 0 10px #4EEE30
                    color #4EEE30
                    position relative
                    top 1px

            .invalid-cross
                width 20px
                height 20px
                display inline-flex
                line-height 12px
                vertical-align top

                &:before
                    content "\2573"
                    font-family Arial
                    font-size 12px
                    font-weight bolder
                    text-shadow 0 0 10px #EE3030
                    color #EE3030

        #connection
            input[type='number'],
            input[name='overallRatio']
                width 240px

            #downloadLimit,
            #uploadLimit
                width 130px

            #proxyServer
                width calc(100% - 220px)
                max-width 650px

            .opensubtitles-options
                display flex
                align-items center
                width 100%

            #overallRatio
                pointer-events none
                -webkit-user-select none

                i
                    padding-left 4px
                    padding-right 8px

            select
                padding-left 12px
                border 1px solid rgba(255,255,255,0.08) !important
                border-radius 11px
                -webkit-appearance none
                height 34px
                line-height 24px
                margin-top -9px
                background-color $InputBoxBg
                cursor pointer
                color $InputBoxText
                font-family $Font, $AlternateFont
                font-size 13px
                outline 0
                padding-right 10px
                width 88px
                box-shadow inset 0 1px 0 rgba(255,255,255,0.04)

            .dropdown-arrow
                width 0
                height 0
                border-left 4px solid transparent
                border-right 4px solid transparent
                border-top 5px solid $Text2
                top 12px
                margin-left -13px
                position relative
                float none
                cursor pointer

            .reset-tvAPI
                font-size 13px
                color $SettingsText2
                transition all .5s
                &:hover
                    cursor pointer
                    color $ButtonBgActive
                    transition all .5s

        #cache
            #faketmpLocation
                width calc(100% - 258px)
                max-width 650px

            .open-tmp-folder,
            .open-downloads-folder
                font-size 16px
                margin -3px -3px -3px 7px
                padding 3px
                border-radius 50%
                transition all .5s
                &:hover
                    cursor pointer
                    color $ButtonBgActive
                    transition all .5s

            .del-seedbox-cache > select
                width 220px

        #database
            #fakedatabaseLocation
                width calc(100% - 310px)
                max-width 650px

            .open-database-folder
                font-size 16px
                margin -3px -3px -3px 3px
                padding 3px
                border-radius 50%
                transition all .5s
                &:hover
                    cursor pointer
                    color $ButtonBgActive
                    transition all .5s

            .import-db
                margin -3px -3px -3px 4px
                padding 3px 4px
                border-radius 50%
                cursor pointer
                transition all .5s
                &:hover
                    color $ButtonBgActive

            .export-database
                margin -3px -3px -3px -2px
                padding 3px 4px
                border-radius 50%
                cursor pointer
                transition all .5s
                &:hover
                    color $ButtonBgActive

        .set-current-filter,
        .reset-current-filter
            font-size 13px
            margin -3px -1px -3px 5px
            padding 3px
            border-radius 50%
            transition all 0.5s
            cursor pointer
            &:hover
                color $ButtonBgActive

        .closeTraktCode
            font-size 13px
            margin 0 2px 0 8px
            transition all 0.5s
            cursor pointer
            &:hover
                color #ee3030

        .reset-current-filter.disabled
            color inherit
            opacity 0.3
            cursor default

        .btns
            padding-top 2px
            padding-right 0
            float right
            &.database
                float left
                padding-top 0
                padding-bottom 8px

        .btn-settings
            position relative
            margin-top 13px
            float left
            padding 0 16px
            margin-right 20px
            border-radius 11px
            height 40px
            background rgba(255,255,255,0.10)
            border 1px solid rgba(255,255,255,0.15)
            text-align center
            color rgba(255,255,255,0.82)
            font-family $ButtonFont, $AlternateFont
            font-size 13px
            line-height 38px
            cursor pointer
            display inline-flex
            align-items center
            justify-content center
            gap 9px
            outline 0
            box-shadow inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 20px rgba(0,0,0,0.16)
            transition background-color 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease
            i
                width 14px
                color $ButtonBgActive
            span
                white-space nowrap
            &> label
                cursor pointer
            &.database
                margin-top 0
            &:hover
                background-color $ButtonBgHover
                color #fff
                border-color rgba(255,255,255,0.20)
                text-decoration none
                box-shadow 0 10px 22px rgba(0,0,0,0.22)
            &.disabled
                background-color $ButtonBgDisabled
                &:hover
                    background-color $ButtonBgDisabled
                &:active
                    background-color $ButtonBgDisabled

            &.ok
                background-color $ButtonBgOk
            &.warning
                background-color rgba($ButtonBgWarning, 0.22)
                border-color rgba($ButtonBgWarning, 0.55)
                i
                    color $ButtonBgWarning
            &:active
                box-shadow inset 0 1px 4px rgba(0,0,0,0.6)
                background $ButtonBgActive

        .maintenance-actions
            display flex
            align-items center
            flex-wrap wrap
            gap 10px
            width 100%

            .btn-settings
                float none
                margin 0

        .dropdown
            select
                margin-left 10px
                position relative
                padding-left 12px
                border 1px solid rgba(255,255,255,0.08) !important
                border-radius 11px
                -webkit-appearance none
                height 34px
                line-height 25px
                margin-top -9px
                background-color $InputBoxBg
                cursor pointer
                color $InputBoxText
                font-family $Font, $AlternateFont
                font-size 13px
                float left
                outline 0
                padding-right 15px
                box-shadow inset 0 1px 0 rgba(255,255,255,0.04)

            option
                background $InputBoxBg
                border 0 !important
                outline 0

            .dropdown-arrow
                width 0
                height 0
                border-left 4px solid transparent
                border-right 4px solid transparent
                border-top 5px solid $Text2
                top 4px
                margin-left -13px
                position relative
                float left
                cursor pointer

    .success_alert
        position fixed
        top 45px
        right 50px
        color $Text1
        font-family $MainFont, $AlternateFont
        font-size 16px

        #checkmark-notify
            display inline-block
            width 20px
            height 20px
            transform rotate(45deg)

        #stem-notify
            position absolute
            width 3px
            height 12px
            background-color $Text1
            left 11px
            top 6px

        #kick-notify
            position absolute
            width 6px
            height 3px
            background-color $Text1
            left 6px
            top 15px

    input[type="text"], input[type="password"], input[type="number"], input[type="color"]
        box-sizing border-box
        margin-left 10px
        margin-top -9px
        padding-left 12px
        height 34px
        border 1px solid rgba(255,255,255,0.08) !important
        border-radius 11px
        line-height 15px
        background-color $InputBoxBg
        background-color rgba(255,255,255,0.09)
        -webkit-backdrop-filter blur(18px) saturate(140%)
        backdrop-filter blur(18px) saturate(140%)
        resize none
        color $InputBoxText
        font-family $Font, $AlternateFont
        font-size 13px
        cursor text
        outline 0 !important
        box-shadow inset 0 1px 0 rgba(255,255,255,0.04)

        &:focus
            border-color rgba(244,185,66,0.45) !important
            box-shadow inset 0 1px 0 rgba(255,255,255,0.05), 0 0 0 3px rgba(244,185,66,0.10)

        &#fakedatabaseLocation
            pointer-events none
            -webkit-user-select none

        &#fakedatabaseLocation,&#settingsIpAddr
            pointer-events none
            -webkit-user-select none

    input[type='color']
        -webkit-appearance none
        width 62px
    input[type='color']::-webkit-color-swatch
        margin 3px -9px 3px -3px

    input[type='number']::-webkit-inner-spin-button
        -webkit-appearance none
        margin 0

    input[type=checkbox]
        &.settings-checkbox
            position absolute
            overflow hidden
            clip rect(0 0 0 0)
            height 1px
            width 1px
            margin -1px
            padding 0
            border 0

        &.settings-checkbox+label.settings-label
            display inline-flex
            align-items flex-start
            font-size 13px
            font-family $Font, $AlternateFont
            vertical-align middle
            cursor pointer
            color $SettingsText1
            min-width 0
            max-width calc(100% - 32px)
            line-height 1.35
            white-space normal
            position relative
            transition color .15s ease-in-out

            &:hover:before
                border-color $ButtonBgActive

        &.settings-checkbox:focus+label.settings-label
            &:before
                border-color $ButtonBgActive
                box-shadow 0 0 0 3px rgba($ButtonBgActive, 0.2)

        &.settings-checkbox:checked+label.settings-label
            &:before
                border-color $ButtonBgActive
                background-color $ButtonBgActive
                box-shadow 0 2px 6px rgba(0,0,0,0.22)

            &:after
                opacity 1
                transform rotate(-45deg) scale(1)

    #subtitles
        #opensubtitlesUsername,
        #opensubtitlesPassword
            width 420px
            max-width calc(100% - 220px)

    input[type="text"]
        &#uploadLimit
            margin-left 7px

    .settings-label
        &:before
            content ''
            box-sizing border-box
            flex 0 0 18px
            width 18px
            height 18px
            margin-right 10px
            position relative
            border 2px solid $CheckboxBg
            border-radius 5px
            background-color rgba(0,0,0,0.08)
            transition background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out

        &:after
            content ''
            position absolute
            width 9px
            height 5px
            margin-top 4px
            margin-left 4px
            border 2px solid #fff
            border-top 0
            border-right 0
            opacity 0
            transform rotate(-45deg) scale(.7)
            transition opacity .15s ease-in-out, transform .15s ease-in-out

    .settings-container-check-settings
        width 14px
        height 14px
        margin-top 59px
        position relative
        label
            cursor pointer
            position absolute
            top 0
            width 14px
            height 14px
            border-radius 3px
            background-clip padding-box
            background-color $InputBoxBg

            &:after
                opacity 0
                content ''
                position absolute
                width 10px
                height 6px
                background transparent
                top 2px
                left 2px
                border 3px solid $ButtonBgActive
                border-top none
                border-right none
                transform rotate(-45deg)
        input[type=checkbox]:checked
            & + label
                &:after
                    opacity 1

@keyframes rotate-forever
    0%
        transform rotate(0deg)
    100%
        transform rotate(360deg)

#header.settings-header
    &:after
        display none

.settings-container-contain
    .settings-container
        > .close-icon
            position absolute
            top -2px
            right 0
            z-index 4
            width 38px
            height 38px
            border-radius 50%
            background rgba(255,255,255,0.08)
            border 1px solid rgba(255,255,255,0.10)
            color rgba(255,255,255,0.78)
            font-size 17px
            line-height 38px
            padding 0
            display flex
            align-items center
            justify-content center
            box-sizing border-box
            text-align center
            -webkit-backdrop-filter blur(16px) saturate(145%)
            backdrop-filter blur(16px) saturate(145%)
            transition color 180ms ease, background-color 180ms ease, transform 180ms ease

            &:hover
                color #fff
                background rgba(255,255,255,0.13)
                transform translateY(-1px)

    @media (max-width: 1120px)
        .settings-container
            width calc(100% - 42px)

            section
                padding 20px

                .title
                    width 145px
                    margin-right 20px

                .content
                    width calc(100% - 165px)

                    span p
                        flex-basis 175px
                        min-width 175px
                        max-width 175px

            #apiserver .opensubtitles-options input,
            #connection #proxyServer
                width calc(100% - 185px)

            #cache #faketmpLocation
                width calc(100% - 223px)

            #database #fakedatabaseLocation
                width calc(100% - 275px)

    @media (max-width: 820px)
        .settings-container
            width calc(100% - 28px)

            section
                display block

                .title
                    width 100%
                    margin 0 0 16px
                    padding 0 0 12px
                    border-right 0
                    border-bottom 1px solid rgba(255,255,255,0.10)

                .content
                    width 100%

                    span
                        align-items flex-start
                        p
                            flex 0 0 100%
                            min-width 100%
                            max-width 100%
                            margin-bottom 8px

            #apiserver .opensubtitles-options,
            #connection .opensubtitles-options
                flex-wrap wrap

                input
                    width calc(100% - 10px)
                    max-width none

            #cache #faketmpLocation,
            #database #fakedatabaseLocation
                width calc(100% - 54px)
                max-width none

.settings-container
    section
        &.advanced
            display none
    .advanced
        display none

.default-frame
    .settings-container-contain
            padding-top 0
            .close-icon
                top 5px
        &::-webkit-scrollbar-track
            margin-top $FilterBarHeight
        .close-icon
            top 45px
