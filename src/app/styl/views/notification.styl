#notification .notification
    display block
    position absolute
    top 78px
    border-radius 18px
    height auto
    min-width 320px
    max-width 440px
    -webkit-user-select none
    opacity 1
    right 24px
    z-index 5000
    font-size 13px
    font-weight normal
    text-align left
    line-height 1.45
    padding 18px 20px
    color rgba(255,255,255,0.88)
    border 1px solid rgba(255,255,255,0.13)
    background rgba(18,20,27,0.90) !important
    box-shadow 0 24px 64px rgba(0,0,0,0.50), inset 0 1px 0 rgba(255,255,255,0.06)
    -webkit-backdrop-filter blur(28px) saturate(150%)
    backdrop-filter blur(28px) saturate(150%)
    transition transform 180ms ease, opacity 180ms ease

    &:empty
        display none

    &.info
        border-left 3px solid $NotificationInfo

    &.success
        border-left 3px solid $NotificationSuccess

    &.warning
        border-left 3px solid $NotificationWarning

    &.danger
        border-left 3px solid $NotificationOrange

    &.error
        border-left 3px solid $NotificationError

    .close
        position absolute
        top 14px
        right 15px
        width 28px
        height 28px
        border-radius 50%
        line-height 28px
        text-align center
        opacity 0.72
        color white
        background rgba(255,255,255,0.08)
        cursor pointer
        &:hover
            opacity 1
            background rgba(255,255,255,0.14)

    .btn-grp
        position relative
        display flex
        gap 8px
        padding-top 12px

    .btn
        min-height 34px
        padding 0 14px
        border-radius 999px
        border 1px solid rgba(255,255,255,0.12)
        background rgba(255,255,255,0.08)
        color rgba(255,255,255,0.88)
        display inline-flex
        align-items center
        justify-content center
        gap 8px
        cursor pointer
        transition all 180ms ease

        &:hover
            background rgba(255,255,255,0.14)
            border-color rgba(255,255,255,0.20)
            transform translateY(-1px)

        &:active
            box-shadow inset 0 1px 4px rgba(0,0,0,0.6)
            transform translateY(0)

        &.primary
            background $ButtonBgActive
            border-color transparent
            color #fff

        label
            cursor pointer

    .btn.chnglog
        margin-right 5px

    h1
        margin 0 32px 5px 0
        color #fff
        font-family $MainFontBold, $AlternateFont
        font-size 16px
        line-height 1.3

    p
        margin 0
        font-weight normal
        line-height 1.5
        color rgba(255,255,255,0.68)

