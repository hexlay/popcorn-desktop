.show-detail-container
    display flex
    position fixed
    width 100%
    padding-top 67px
    background $BgColor1
    flex-direction column

    .show-header
        width 100vw
        min-height 215px

        .sh-backdrop
            .shb-img
                position absolute
                min-height 100%
                margin-top -35px
                width 100vw
                background-repeat no-repeat
                background-size cover
                background-position center
                -webkit-filter blur(60px) brightness(0.7)
                background-color $ShowBgColor1
                opacity 0
                &.fadein
                    transition opacity .3s ease-in
                    opacity 1

        .sh-poster
            float left
            width 198px
            height 100%
            z-index 20
            position relative
            pointer-events none
            transition transform 0.05s ease-out

            .shp-img
                position relative
                margin-left 32px
                margin-top 10px
                width 134px
                height 197px
                box-shadow 0px 0px 10px
                background-size 100% 100%
                background-position center
                background-repeat no-repeat
                border-radius 4px
                opacity 0
                background-color $ShowBgColor1
                pointer-events auto
                cursor pointer
                &.fadein
                    transition opacity .3s ease-in
                    opacity 1

        .sh-poster.active
            transition transform 0.12s ease-out

            .shp-img
                border-radius 2px

        .sh-metadata
            float left
            position relative
            height 194px
            width calc(100% - 198px)
            padding-top 10px
            padding-right 45px

            .shm-title
                color #fff
                font-family $Font
                -webkit-font-smoothing antialiased
                font-size 28px
                margin-bottom 8px
                margin-top 5px

            .shm-infos
                div
                    float left
                    font-size 11px
                    font-family $MainFontBold
                    color #fff
                    -webkit-font-smoothing antialiased

                    &:not(.shmi-tmdb-link)
                        &:hover ~ div.shmi-tmdb-link
                            opacity 0.4
                            transition-delay .8s

                div.shmi-year
                    cursor pointer

                div.shmi-tmdb-link
                    padding-left 12px
                    padding-right 6px
                    cursor pointer
                    opacity 0
                    transition opacity .3s ease-in
                    transition-delay .2s

                    &:hover
                        opacity 1
                        transition-delay 0s

                    &.disabled
                        &:hover
                            cursor default
                            opacity 0.4

                div.shmi-imdb
                    cursor pointer
                    background url(../images/icons/imdb.png) no-repeat
                    width 27px
                    height 16px
                    position relative
                    top -2px

                div.shmi-rating
                    cursor pointer

                    .hidden
                        display none

                    .number-container-tv
                        position relative
                        font-size 12px
                        font-family $MainFontBold
                        color #FFF

                        em
                            font-size 0.8em

                    .star-container-tv
                        position relative
                        opacity 1

                        .rating-star
                            color #ffc900
                            font-size 11px
                            padding-right 3px

                        .rating-star-half
                            color #ffc900
                            font-size 11px
                            margin-left -4px
                            padding-right 3px

                        .rating-star-half-empty
                            color #a3a5a7
                            font-size 11px
                            margin-left -4px

                        .rating-star-empty
                            color #a3a5a7
                            font-size 11px
                            padding-right 3px

                        .rating-star-half-container
                            width 1em
                            height 1em
                            line-height 1em
                            margin-top -3px
                            margin-left 4px

                span.dot
                    margin 4.5px 15px 0 15px
                    float left
                    width 3px
                    height 3px
                    border-radius 2px
                    background-clip padding-box
                    background-color #dbdbdd
                    cursor default

            .shm-synopsis
                color #fff
                float left
                width 100%
                text-align justify
                font-family $MainFont
                -webkit-font-smoothing antialiased
                font-size 12px
                line-height 22px
                max-height 107px
                padding-right 8px
                margin-top 8px
                overflow hidden
                scrollable()

        .sh-metadata.active
            filter blur(4px)
            pointer-events none

        .sh-actions
            float left
            position relative
            width calc(100% - 198px)
            height 35px
            margin-top -15px
            padding-right 45px

            display flex
            flex-direction row
            justify-content space-between
            white-space nowrap

            .dropdowns-container
                margin -10px -30px 0 0

                #audio-dropdown .lang-dropdown
                    background none

            .sha-bookmark
                float left
                cursor pointer
                padding-left 24px
                color #FFF
                position relative
                font-family $MainFont
                font-smoothing antialiased
                font-size 12px
                line-height 37px
                margin-top -2px
                &:before
                    content "\f004"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color #FFF
                    top 0
                    left 0
                    bottom 0
                    right 0
                    opacity 1
                    transition opacity 0.5s

                &:after
                    content "\f004"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color $ButtonBgActive
                    top 0
                    left 0
                    bottom 0
                    right 0
                    opacity 0
                    transition opacity 0.5s

                &:hover
                    &:before
                        opacity 0

                    &:after
                        opacity 1

                &.selected
                    height 18px
                    width 200px
                    &:before
                        content "\f004"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 18px
                        color $FavoriteColor
                        top 0
                        left 0
                        bottom 0
                        right 0
                        opacity 1
                        transition opacity 0.5s

                    &:after
                        content "\f004"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 18px
                        color #FFF
                        top 0
                        left 0
                        bottom 0
                        right 0
                        opacity 0
                        transition opacity 0.5s

                    &:hover
                        &:before
                            opacity 0

                        &:after
                            opacity 1

            .sha-watched
                float left
                cursor pointer
                padding-left 28px
                margin-left 20px
                color #FFF
                position relative
                font-family $MainFont
                font-smoothing antialiased
                font-size 12px
                line-height 37px
                margin-top -2px
                display none

                &:before
                    content "\f070"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color #FFF
                    left 0
                    opacity 1
                    transform scaleY(0.9)
                    transition opacity 0.5s

                &:after
                    content "\f00c"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 20px
                    color #299000
                    left 0
                    opacity 0
                    transition opacity 0.5s

                &:hover, &.selected
                    &:before
                        opacity 0
                    &:after
                        opacity 1

        .sh-actions.active
            filter blur(4px)
            pointer-events none

    .show-details
        width 100vw
        z-index 1
        background rgba($ShowBgColor1, 0.7)
        height calc(100vh - 282px)
        display grid
        padding-left 20px
        gap 10px
        grid-template-columns fit-content(165px) 2fr minmax(480px, 1fr)
        grid-template-rows 2fr auto
        grid-template-areas "seasons  episodes overview" "torrents torrents overview"
        &.transpOff
            background $ShowBgColor1
        &.transpVLow
            background rgba($ShowBgColor1, 0.9)
        &.transpLow
            background rgba($ShowBgColor1, 0.8)
        &.transpHigh
            background rgba($ShowBgColor1, 0.6)
        &.transpVHigh
            background rgba($ShowBgColor1, 0.5)

        .sd-seasons ul, .sd-episodes ul
            position absolute
            top 45px
            bottom 0
            cursor pointer
            direction rtl
            white-space nowrap
            scrollable()

            li
                padding 0px 15px
                margin 1px 0px 1px 1px
                float left
                width calc(100% - 7px)

                .watched
                    padding 9px 0
                    color $ShowWatchedIcon_false
                    transition color .5s

                    &:hover
                        color $ShowWatchedIcon_hover

                    &.true
                        color $ShowWatchedIcon_true

            li:nth-child(odd)
                background-color rgba($ShowOddHighlight, $ShowOddHighlightOp)
                &:not(.active).transpOff
                    background-color $ShowBgColor2
                    &:hover
                        background-color $EpisodeSelectorHover

            li:hover
                background rgba($EpisodeSelectorHoverTran,20%)

            li:not(.active).transpOff:hover
                background $EpisodeSelectorHover

            li.active
                background-color $EpisodeSelectorBg
                position relative

                &:after
                    content ""
                    position absolute
                    top 0px
                    right -12px
                    width 0
                    height 0
                    border-color rgba(0,0,0,0) rgba(0,0,0,0) rgba(0,0,0,0) $EpisodeSelectorBg
                    border-style solid
                    border-width 16px 6px 17px 6px

            a
                text-decoration none
                font-size 15px
                line-height 34px
                font-weight normal
                float left
                flex-direction row
                direction ltr

                span
                    float left
                    margin 0px 15px 0px 5px

                div
                    white-space nowrap
                    border-left 1px solid $ShowBgColor1
                    padding-left 30px
                    text-align left
                    overflow hidden
                    text-overflow ellipsis

        .sd-seasons, .sd-episodes
            position relative
            height 100%
            .sds-title, .sde-title
                font-size 24px
                overflow hidden
                text-overflow ellipsis
                white-space nowrap
                margin-bottom 15px
                margin-top 2px
                color $ShowText1

        .sd-seasons
            min-width 165px
            padding 10px

            .sds-list ul a
                color $SaisonListText
                white-space nowrap

            .sds-list ul li.active a
                color $EpisodeSelectorText

        .sd-episodes
            grid-area episodes
            padding 10px

            .sde-list ul
                width calc(100% - 10px)

            .sde-list ul li a
                color $EpisodeListText
                font-family $MainFont
                min-width 70px
                max-width calc(60vw - 290px)

            .sde-list ul li.active a
                color $EpisodeSelectorText

        .sd-overview
            background rgba($ShowBgColor1, 0.3)
            grid-area overview
            padding 10px 30px 10px 18px
            display grid
            grid-template-rows auto 2fr
            &.transpOff
                background $ShowBgColor2

            .sdo-infos
                height fit-content
                overflow-x hidden

                .sdoi-title
                    overflow hidden
                    white-space nowrap
                    text-overflow ellipsis
                    font-size 24px
                    margin-top 2px
                    padding-bottom 6px
                    color $ShowText1

                .sdoi-links
                    position absolute
                    right 42px
                    margin-top -6px

                    &>div
                        padding 5px 3px
                        border-radius 50%
                        cursor pointer
                        position relative

                    .health-icon
                        font-size 14px
                        color #737577
                        transition all .3s ease-in

                        &.Bad
                            color #d53f3f
                        &.Medium
                            color #ece523
                        &.Good
                            color #a3e147
                        &.Excellent
                            color #2ad942

                    .magnet-icon
                        font-size 13px
                        color #DDD
                        margin-right 2px

                        &:hover
                            color #FFF
                            transition all .5s

                    .source-icon
                        display inline-block
                        font-size 13px
                        color #DDD
                        margin-right 0px
                        top 3px

                        &:hover
                            color #FFF
                            transition all .5s
                        img
                            height 16px

                .sdoi-aired
                    font-size 12px
                    line-height 15px
                    margin-bottom 10px
                    color $ShowText2

                    .sdoi-date
                        overflow hidden
                        white-space nowrap
                        text-overflow ellipsis

                .sdoi-synopsis
                    color $ShowText1
                    font-size 13px
                    line-height 18px
                    text-align justify
                    margin-top 10px
                    padding 2px 15px 5px 0
                    height fit-content
                    scrollable()

            #torrent-list
                height auto
                margin 10px -10px 10px -5px

            .sdo-watch
                height 60px
                padding 5px 0px 15px 0px
                margin-bottom -5px

                &.disabled
                    margin-bottom 50px

                .play-selector
                    position relative
                    float right
                    margin-top 6px

                    &.disabled
                        position absolute
                        right 5px
                        margin-top -5px
                        cursor pointer
                        opacity 1
                        filter none

                .show-all-torrents
                    float left
                    font-family $MainFont
                    -webkit-font-smoothing antialiased
                    font-size 11px
                    color $ShowText1
                    transition all .2s ease-in, margin 0s
                    padding 0 6px
                    margin 13px 6px 0 0
                    border-radius 10px
                    height 19px
                    line-height 19px
                    cursor pointer

                    &:hover, &.active
                        color $QualitySelectorText
                        background $QualitySelectorBg

                    &.fa-spinner
                        font-family "Font Awesome 6 Free"
                        transition none
                        margin-left 6px
                        color $ShowText1

                        &:hover, &.active
                            background none

                    &.loading
                        display flex
                        align-items center
                        justify-content center
                        width 24px
                        padding 0
                        cursor wait

                .episode-source-status
                    float left
                    display flex
                    align-items center
                    gap 7px
                    min-height 32px
                    margin-right 8px
                    color rgba(255,255,255,.72)
                    font-size 11px
                    padding 0 10px
                    border 1px solid rgba(255,255,255,.08)
                    border-radius 999px
                    background rgba(255,255,255,.045)
                    box-shadow inset 0 1px 0 rgba(255,255,255,.035)

                    .episode-source-empty
                        display none
                        color #e6a3a3

                    &.is-empty
                        color rgba(255,255,255,.62)
                        border-color rgba(230,163,163,.15)
                        background rgba(230,120,120,.055)
                        cursor pointer
                        transition color .18s ease, border-color .18s ease, background .18s ease

                        &:hover
                            color rgba(255,255,255,.84)
                            border-color rgba(244,185,66,.28)
                            background rgba(244,185,66,.08)

                        .source-loader
                            display none

                        .episode-source-empty
                            display inline-block

                .sdow-quality
                    margin-top 13px
                    float left

                    div
                        cursor pointer
                        float left
                        font-family $MainFont
                        -webkit-font-smoothing antialiased
                        font-size 11px
                        color $ShowText1
                        transition all .2s ease-in
                        padding 4px
                        margin-right 6px

                    .disabled
                        opacity .3
                        cursor default

                    .active
                        cursor pointer
                        opacity 1
                        color $QualitySelectorText
                        background $QualitySelectorBg
                        border-radius 10px
                        font-family $MainFontBold

                .sdow-watchnow
                    margin-top 6px
                    float right

                    &.disabled
                        visibility hidden

                    #player-chooser
                        .button
                            margin-right 0px

        .sd-torrents
            grid-area torrents
            max-height 300px

            .action
                color rgba(0,0,0,0) !important
                width 0px !important
                padding 0px !important
                pointer-events none

                .item-download
                    font-family $Font, $AlternateFont

        > .spinner
            position fixed
            width 100%
            height 100%
            background rgba(0, 0, 0, 0.5) center center no-repeat
            pointer-events all
            z-index 1

            .loading-container
                margin 180px auto 0px
                opacity .8

    .show-details.active
        filter brightness(50%) blur(4px)
        pointer-events none

// Modern series detail composition.
.show-detail-container
    display grid
    grid-template-rows auto 1fr
    gap 22px
    position fixed
    width 100%
    height 100vh
    padding $HeaderHeight + 34px 34px 34px
    box-sizing border-box
    overflow hidden
    background #080a0f
    animation appSurfaceEnter $AppMotionNormal $AppMotionEase both

.shows-container-contain.detail-exiting
    pointer-events none

    .show-detail-container
        animation appSurfaceExit $AppMotionFast ease both

.show-detail-container
    .close-icon
        top $HeaderHeight + 16px
        right 24px
        z-index 5
        width 38px
        height 38px
        border-radius 50%
        background rgba(255,255,255,0.08)
        border 1px solid rgba(255,255,255,0.10)
        color rgba(255,255,255,0.78)
        font-size 17px
        line-height 38px
        text-align center
        -webkit-backdrop-filter blur(16px) saturate(145%)
        backdrop-filter blur(16px) saturate(145%)

        &:hover
            color #fff
            background rgba(255,255,255,0.13)

    .show-header
        position relative
        z-index 1
        display grid
        grid-template-columns 160px 1fr
        grid-template-rows 1fr auto
        grid-template-areas "poster meta" "poster actions"
        gap 18px 24px
        width auto
        min-height 0
        height 286px
        padding 22px 76px 20px 22px
        box-sizing border-box
        overflow hidden
        border 1px solid rgba(255,255,255,0.11)
        border-radius 28px
        background linear-gradient(135deg, rgba(18,20,27,0.68), rgba(12,14,20,0.46))
        box-shadow 0 30px 76px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.04)
        -webkit-backdrop-filter blur(30px) saturate(155%)
        backdrop-filter blur(30px) saturate(155%)

        .sh-backdrop
            position absolute
            inset 0
            z-index -1
            pointer-events none

            .shb-img
                position absolute
                inset -34px
                min-height 0
                width auto
                margin 0
                opacity 0
                background-size cover
                background-position center
                -webkit-filter blur(28px) brightness(0.58) saturate(1.16)
                filter blur(28px) brightness(0.58) saturate(1.16)
                transform scale(1.04)

                &.fadein
                    transition opacity 420ms ease, transform 720ms cubic-bezier(.2,.8,.2,1)
                    opacity .82
                    transform scale(1.01)

            &:after
                content ""
                position absolute
                inset 0
                background radial-gradient(circle at 78% 16%, rgba(244,185,66,0.16), transparent 28%), radial-gradient(circle at 30% 88%, rgba(183,64,45,0.20), transparent 34%), linear-gradient(90deg, rgba(5,7,11,0.88), rgba(8,9,13,0.58) 46%, rgba(5,7,11,0.84))

        .sh-poster
            grid-area poster
            float none
            width 160px
            height 242px
            z-index 1
            pointer-events none

            .shp-img
                width 100%
                height 100%
                margin 0
                border-radius 20px
                background-size cover
                background-position center
                box-shadow 0 24px 58px rgba(0,0,0,0.58), 0 0 0 1px rgba(255,255,255,0.12)
                opacity 0
                transform translateY(18px) scale(.94)
                pointer-events auto
                cursor pointer

                &.fadein
                    transition opacity 260ms ease, transform 260ms $AppMotionEase, box-shadow 220ms $AppMotionEase
                    opacity 1
                    transform translateY(0) scale(1)

                &:hover
                    transform translateY(-3px) scale(1.01)
                    box-shadow 0 30px 70px rgba(0,0,0,0.64), 0 0 0 1px rgba(244,185,66,0.22)

        .sh-metadata
            grid-area meta
            float none
            width auto
            height auto
            min-width 0
            padding 0
            display flex
            flex-direction column

            .shm-title
                margin 0 0 16px
                color #fff
                font-family $MainFontBold
                font-size clamp(34px, 4vw, 56px)
                line-height 1.02
                letter-spacing -0.055em

            .shm-infos
                display flex
                align-items center
                flex-wrap wrap
                gap 10px 0
                min-height 24px
                margin-bottom 18px

                div
                    float none
                    font-size 13px
                    color rgba(255,255,255,0.78)
                    line-height 20px

                span.dot
                    float none
                    margin 0 12px
                    width 4px
                    height 4px
                    background rgba(244,185,66,0.75)

                div.shmi-imdb
                    top 0
                    margin-top 1px

                div.shmi-rating
                    display flex
                    align-items center

                    .star-container-tv
                        .rating-star,
                        .rating-star-half
                            color $FilterBarActive
                            font-size 13px

                        .rating-star-empty,
                        .rating-star-half-empty
                            color rgba(255,255,255,0.36)
                            font-size 13px

            .shm-synopsis
                float none
                width auto
                max-height none
                margin 0
                padding 0
                color rgba(255,255,255,0.84)
                font-size 15px
                line-height 1.58
                text-align left
                overflow auto
                scrollable()

        .sh-actions
            grid-area actions
            float none
            width auto
            height auto
            margin 0
            padding 0
            display flex
            align-items flex-end
            justify-content space-between
            gap 18px

            .flex-left
                display flex
                gap 16px
                min-width 0

            .sha-bookmark,
            .sha-watched
                float none
                height 28px
                margin 0
                padding-left 27px
                color rgba(255,255,255,0.84)
                font-size 13px
                line-height 28px

                &:before,
                &:after
                    top 0
                    font-size 17px

            .sha-watched
                display block
                margin-left 0

            .dropdowns-container
                margin 0
                display flex
                flex-direction column
                align-items flex-end
                gap 10px

            #subs-dropdown,
            #audio-dropdown
                position relative
                width 160px
                max-width 100%

                .lang-dropdown
                    width 100%
                    box-sizing border-box
                    height 36px
                    padding 0 12px 0 14px
                    border 1px solid rgba(255,255,255,0.12)
                    border-radius 999px
                    background rgba(255,255,255,0.055)
                    box-shadow inset 0 1px 0 rgba(255,255,255,0.05)
                    color rgba(255,255,255,0.84)
                    font-size 13px
                    line-height 36px
                    transition background-color 160ms ease, border-color 160ms ease

                    &:hover
                        background rgba(255,255,255,0.075)
                        border-color rgba(255,255,255,0.18)

                    .lang-name
                        min-width 0
                        overflow hidden
                        text-overflow ellipsis
                        white-space nowrap

                    .selected-lang
                        flex 0 0 auto
                        width 22px
                        height 16px
                        margin 0 8px

                    .flag.none
                        display none

                    .caret
                        flex 0 0 auto
                        margin 0
                        color rgba(255,255,255,0.70)

                .dropup
                    position relative
                    width 100%
                    overflow visible

                .dropdown-menu
                    right 0
                    left auto
                    bottom 100%
                    min-width 260px
                    max-width 340px
                    opacity 1
                    margin 0 0 12px
                    padding 10px
                    background linear-gradient(135deg, rgba(28,31,39,0.78), rgba(13,15,22,0.66))
                    border 1px solid rgba(255,255,255,0.13)
                    border-radius 20px
                    box-shadow 0 28px 70px rgba(0,0,0,0.52), inset 0 1px 0 rgba(255,255,255,0.05)
                    -webkit-backdrop-filter blur(28px) saturate(160%)
                    backdrop-filter blur(28px) saturate(160%)

                .lang-option-list
                    display flex
                    flex-direction column
                    gap 4px
                    margin 0

                    .lang-option
                        display flex
                        align-items center
                        gap 12px
                        min-height 42px
                        padding 8px 12px
                        border-radius 13px
                        color rgba(255,255,255,0.86)
                        cursor pointer
                        transition background-color 160ms ease, color 160ms ease, transform 160ms ease

                        &:hover
                            color #fff
                            background rgba(244,185,66,0.17)
                            transform translateX(2px)

                        .flag
                            flex 0 0 auto
                            width 36px
                            height 27px
                            margin 0
                            border-radius 7px
                            background-size cover
                            background-position center
                            box-shadow 0 8px 22px rgba(0,0,0,0.26)

                        .lang-option-name
                            min-width 0
                            overflow hidden
                            text-overflow ellipsis
                            white-space nowrap
                            font-size 14px

                .lang-dropdown
                    display flex
                    align-items center
                    width 160px
                    height 38px
                    padding 0 14px 0 16px
                    box-sizing border-box
                    border-radius 999px
                    background rgba(255,255,255,0.07)
                    border 1px solid rgba(255,255,255,0.10)
                    color rgba(255,255,255,0.82)
                    transition background-color 160ms ease, border-color 160ms ease

                    &:hover
                        background rgba(255,255,255,0.10)
                        border-color rgba(244,185,66,0.24)

                    .lang-name
                        flex 1 1 auto
                        overflow hidden
                        text-overflow ellipsis
                        white-space nowrap

                    .flag.toggle
                        flex 0 0 auto
                        top auto
                        width 32px
                        height 24px
                        margin 0 10px 0 12px
                        border-radius 6px
                        background-size cover
                        background-position center

                    .caret
                        flex 0 0 auto
                        margin 0

    .show-details
        z-index 1
        width auto
        height auto
        min-height 0
        padding 0
        gap 18px
        display grid
        grid-template-columns 190px minmax(420px, 1fr) minmax(360px, .72fr)
        grid-template-rows 1fr
        grid-template-areas "seasons episodes overview"
        background transparent !important

        .sd-seasons,
        .sd-episodes,
        .sd-overview
            min-height 0
            height auto
            padding 20px
            box-sizing border-box
            border 1px solid rgba(255,255,255,0.10)
            border-radius 24px
            background linear-gradient(135deg, rgba(18,20,27,0.60), rgba(12,14,20,0.46)) !important
            box-shadow 0 24px 60px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.04)
            -webkit-backdrop-filter blur(24px) saturate(150%)
            backdrop-filter blur(24px) saturate(150%)
            overflow hidden

        .sd-seasons,
        .sd-episodes
            .sds-title,
            .sde-title
                margin 0 0 18px
                color rgba(255,255,255,0.92)
                font-family $MainFontBold
                font-size 25px
                line-height 1.1
                letter-spacing -0.035em

            ul
                position absolute
                top 60px
                right 12px
                bottom 12px
                left 12px
                direction ltr
                white-space normal
                overflow auto
                scrollable()

                li
                    float none
                    display flex
                    align-items center
                    width auto
                    height 44px
                    min-height 44px
                    margin 0 0 8px
                    padding 0
                    border-radius 13px
                    background rgba(255,255,255,0.04)
                    transition background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease

                    &:nth-child(odd)
                        background rgba(255,255,255,0.055)

                    &:hover
                        background rgba(255,255,255,0.08)
                        transform translateX(2px)

                    &.active
                        background linear-gradient(135deg, rgba(244,185,66,0.82), rgba(244,185,66,0.58))
                        box-shadow 0 12px 26px rgba(244,185,66,0.15)

                        &:after
                            display none

                        a
                            color #15110a

                    a
                        float none
                        display flex
                        align-items center
                        width 100%
                        height 44px
                        min-height 44px
                        color rgba(255,255,255,0.82)
                        font-size 14px
                        line-height 1.2
                        box-sizing border-box

                        span
                            flex 0 0 40px
                            margin 0
                            text-align center

                        div
                            flex 1
                            min-width 0
                            padding-left 16px
                            border-left 1px solid rgba(255,255,255,0.08)
                            overflow hidden
                            text-overflow ellipsis
                            white-space nowrap

        .sd-seasons
            grid-area seasons
            min-width 0

            .sds-list ul a
                color rgba(255,255,255,0.82)
                padding 0 16px

        .sd-episodes
            grid-area episodes

            .sde-list
                position absolute
                inset 0
                top 0
                pointer-events none

                .tab-episodes
                    display none
                    position absolute
                    inset 0
                    pointer-events auto

                    &.current
                        display block

            .sde-list ul
                width auto

            .sde-list ul li a
                max-width none
                color rgba(255,255,255,0.82)

            .sde-list ul li
                padding 0 8px 0 0

                &.active
                    background linear-gradient(135deg, rgba(244,185,66,0.86), rgba(244,185,66,0.62))

                    .watched
                        color rgba(20,16,8,0.50)

            .watched
                flex 0 0 34px
                padding 0
                text-align center
                align-self center
                color rgba(255,255,255,0.28)

        .sd-overview
            grid-area overview
            display flex
            flex-direction column
            padding 22px

            .sdo-infos
                flex 1 1 auto
                min-height 0
                overflow auto
                scrollable()

                .sdoi-title
                    margin 0 44px 8px 0
                    padding 0
                    color rgba(255,255,255,0.94)
                    font-family $MainFontBold
                    font-size 26px
                    line-height 1.14
                    letter-spacing -0.035em
                    white-space normal

                .sdoi-links
                    right 20px
                    margin-top 0

                    > div
                        padding 5px
                        color rgba(255,255,255,0.72)

                .sdoi-aired
                    margin 0 0 14px
                    color rgba(255,255,255,0.60)
                    font-size 13px
                    line-height 1.4

                .sdoi-synopsis
                    margin 0
                    padding 0
                    color rgba(255,255,255,0.82)
                    font-size 15px
                    line-height 1.55
                    text-align left

            #torrent-list
                flex 0 0 auto
                max-height 190px
                margin 18px 0 0
                border 1px solid rgba(255,255,255,0.08)
                background rgba(0,0,0,0.16)
                border-radius 18px
                overflow auto
                scrollable()

            .sdo-watch
                flex 0 0 auto
                height auto
                min-height 54px
                margin 18px 0 0
                padding 0
                display flex
                align-items center
                flex-wrap wrap
                gap 12px

                .sdow-quality
                    float none
                    margin 0
                    display flex
                    align-items center
                    flex-wrap wrap
                    gap 4px

                    div
                        float none
                        margin 0
                        padding 7px 8px
                        border-radius 10px
                        color rgba(255,255,255,0.78)

                    .active
                        color #12100a
                        background $FilterBarActive

                .show-all-torrents
                    float none
                    flex 0 0 auto
                    margin 0
                    height 32px
                    line-height 32px
                    padding 0 10px
                    color rgba(255,255,255,0.82)

                    &.loading
                        width 32px
                        padding 0

                .episode-source-status
                    float none
                    flex 0 0 auto
                    margin 0

                .sdow-watchnow
                    float none
                    margin 0 0 0 auto
                    flex 0 0 auto

                    #player-chooser
                        .button.dropup
                            position relative
                            display flex
                            align-items center
                            height 46px
                            min-width 172px
                            margin 0
                            padding 0
                            border-radius 999px
                            overflow visible
                            box-shadow none
                            transition background-color 160ms ease

                            #watch-now
                                display flex
                                align-items center
                                justify-content center
                                height 46px
                                min-width 118px
                                padding 0 24px
                                margin 0
                                line-height 46px
                                position relative
                                border-radius 999px 0 0 999px

                                &:after
                                    display none
                                    content none

                            .playerchoice
                                display grid
                                grid-template-columns 22px 0
                                align-items center
                                justify-content center
                                gap 12px
                                width 70px
                                height 46px
                                margin 0
                                padding 0
                                box-sizing border-box
                                border-left 1px solid rgba(55,38,8,0.18)
                                background rgba(70,45,0,0.06)
                                border-radius 0 999px 999px 0

                                &:after
                                    display none

                                .imgplayerchoice
                                    float none
                                    width 21px
                                    height 21px
                                    margin 0
                                    opacity .64
                                    filter brightness(0) saturate(100%) invert(9%) sepia(22%) saturate(1079%) hue-rotate(2deg) brightness(96%) contrast(92%)

                                .caret
                                    margin 0
                                    border-top-color rgba(25,18,7,0.88)

                        .playerchoicemenu
                            right 0
                            bottom 100%
                            min-width 250px
                            max-width 300px
                            opacity 1
                            margin 0 0 12px
                            padding 10px
                            background linear-gradient(135deg, rgba(28,31,39,0.78), rgba(13,15,22,0.66))
                            border 1px solid rgba(255,255,255,0.13)
                            border-radius 20px
                            box-shadow 0 28px 70px rgba(0,0,0,0.52), inset 0 1px 0 rgba(255,255,255,0.05)
                            -webkit-backdrop-filter blur(28px) saturate(160%)
                            backdrop-filter blur(28px) saturate(160%)

        .sd-torrents
            display none

@media (max-width: 1260px)
    .show-detail-container
        .show-details
            grid-template-columns 170px minmax(360px, 1fr) minmax(320px, .78fr)

        .show-header
            grid-template-columns 140px 1fr

            .sh-poster
                width 140px
