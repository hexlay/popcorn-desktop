.vpn-connected
    color #38A169 !important

.vpn-disconnected
    color #E53E3E !important

.filter-bar
    z-index 10
    width 100%
    opacity 1
    background-color transparent
    -webkit-user-select none
    position absolute
    top $TitleHeight
    height $FilterBarHeight
    -webkit-app-region no-drag
    box-shadow none
    border-top 0
    border-bottom 0
    display flex
    align-items center
    box-sizing border-box
    padding 0 22px
    -webkit-backdrop-filter none
    backdrop-filter none

    .nav
        height 100%
        display flex
        align-items center
        float none

    .nav-hor
        > li
            line-height normal

    .nav.left
        flex 0 0 auto
        gap 6px

    .brand-lockup
        display flex
        align-items center
        gap 9px
        height 38px
        padding 0 14px 0 0
        margin-right 8px
        color $Text1
        font-family $MainFontBold
        font-size 15px
        letter-spacing -0.01em
        white-space nowrap

        img
            width 23px
            height 23px
            display block

    .source
        box-sizing border-box
        color $FilterBarText
        text-align center
        cursor pointer
        height 36px
        margin-top 0
        margin-right 0
        padding 9px 14px 0
        border-radius 999px
        font-family $MainFont
        font-size 14px
        letter-spacing 0.01em
        transition background-color 180ms ease, color 180ms ease, box-shadow 180ms ease

        &:hover
            color $FilterBarTextHover
            background rgba(255,255,255,0.08)

        &.active
            color $ButtonText
            background $FilterBarActive
            box-shadow 0 10px 24px rgba(244,185,66,0.24)

    .nav.filters
        flex 0 0 auto
        margin-left 24px
        gap 8px

    .nav.right
        flex 0 0 auto
        margin-left auto
        margin-right 0
        gap 10px

    .filter
        padding 0
        margin-left 0
        height 36px

        & > a
            display inline-block
            padding 9px 13px 0
            height 36px
            color $FilterBarText
            background-color rgba(255,255,255,0.06) !important
            border 1px solid rgba(255,255,255,0.08)
            border-radius 999px
            transition all 180ms ease

            &:hover
                color $FilterBarTextHover
                background-color rgba(255,255,255,0.10) !important
        .value
            color $FilterBarActive
            padding-left 8px

        .dropdown-menu
            font-size 0.9em
            scrollable()
            max-height 445px
            margin-top 14px
            padding 8px
            border-radius 16px
            border 1px solid rgba(255,255,255,0.10)
            box-shadow 0 24px 54px rgba(0,0,0,0.48)
            -webkit-backdrop-filter blur(24px) saturate(145%)
            backdrop-filter blur(24px) saturate(145%)

            li
                margin 4px 0

                &:first-child
                    margin-top 0

                &:last-child
                    margin-bottom 0

                a
                    display block
                    padding 10px 14px
                    border-radius 12px
                    color rgba(255,255,255,0.86)
                    line-height 1.25
                    transition background-color 160ms ease, color 160ms ease

                    &:hover,
                    &:focus
                        color #fff
                        background rgba(255,255,255,0.08)

                    &.active
                        color #161108
                        background rgba(244,185,66,0.86)

                        &:hover,
                        &:focus
                            color #161108
                            background rgba(244,185,66,0.92)

    i
        transition color 180ms ease, background-color 180ms ease, transform 180ms ease
        margin 0
        padding 9px
        color $FilterBarIcon
        font-size 1.3em
        width 36px
        height 36px
        border-radius 50%
        text-align center
        &:hover
            color $FilterBarIconHover
            background rgba(255,255,255,0.08)
            transform translateY(-1px)
            cursor pointer

        &.active
            &.favorites
                color $FavoriteColor
                &:hover
                    color darken($FavoriteColor, 10)
                    transition all .5s

            &.watchlist
                color $FilterBarActive

            &.torrent-collection
                color $FilterBarActive

            &.about
                color $FilterBarIconHover

            &.vpn
                color $FilterBarIconHover
            &.seedbox
                color $FilterBarActive

    .clear
        display none

    .search
        margin-right 2px

        form
            position relative

            &:before
                content '\f002'
                font-family "Font Awesome 6 Free"
                font-weight 900
                font-style normal
                transition color 0.5s
                color $FilterBarIcon
                position absolute
                top 10px
                left 12px
                z-index 2
                font-size 1.4em

            &.edited .clear
                display block
                font-weight bold
                transition color 0.5s
                color $FilterBarIcon
                position absolute
                top 9px
                right 8px
                padding 3px 5px
                font-size 1.2em

            &.edited input, input:focus, input.expanded
                width 210px
                background-color $SearchBoxBg
                color $FilterBarText
                padding-left 36px

            &.edited, &:hover
                cursor pointer
                &:before
                    color $FilterBarIconHover

            input
                line-height normal
                -webkit-app-region no-drag
                outline none
                cursor text
                width 190px
                height 36px
                position relative
                background $FilterBarBg no-repeat right center
                background-position right 3px center
                border solid 1px rgba(255,255,255,0.08)
                margin 0
                padding 0 12px
                padding-left 36px
                border-radius 10em
                -webkit-appearance textfield
                -webkit-box-sizing content-box
                transition width 220ms ease, background-color 180ms ease, border-color 180ms ease

                @media (max-width: 1280px)
                    width 150px

                @media (max-width: 1120px)
                    width 110px

                &:focus
                    cursor auto
                    &:before
                        color $FilterBarIconHover

                &::-moz-placeholder,
                &::-webkit-input-placeholder
                    color transparent

                &:focus::-webkit-input-placeholder
                    color rgba($FilterBarText,.7)

    @media (max-width: 1320px)
        padding 0 16px

        .brand-lockup span
            display none

        .source
            padding-left 12px
            padding-right 12px

        .nav.filters
            margin-left 14px

    @media (max-width: 1120px)
        .nav.filters .filter.ratings,
        .nav.filters .filter.types
            display none
