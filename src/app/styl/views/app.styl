support-for-ie = false
vendor-prefixes = webkit official

@import 'nib'

global-reset()

$TitleHeight = 38px
$FilterBarHeight = 64px
$HeaderHeight = 102px
$MovieListPadding = calc(100% - 67px)

$AppMotionEase = cubic-bezier(.2,.8,.2,1)
$AppMotionFast = 180ms
$AppMotionNormal = 320ms
$AppGlassBg = linear-gradient(180deg, rgba(45,47,54,0.28), rgba(16,18,24,0.36))
$AppGlassBorder = rgba(255,255,255,0.15)
$AppGlassHighlight = rgba(255,255,255,0.07)

app-glass-panel()
    background $AppGlassBg
    border 1px solid $AppGlassBorder
    box-shadow inset 0 1px 0 $AppGlassHighlight

app-glass-control()
    background rgba(255,255,255,0.09)
    border 1px solid rgba(255,255,255,0.14)

@keyframes appSurfaceEnter
    0%
        opacity 0
        transform translateY(14px) scale(.985)
    100%
        opacity 1
        transform translateY(0) scale(1)

@keyframes appSurfaceExit
    0%
        opacity 1
        transform translateY(0) scale(1)
    100%
        opacity 0
        transform translateY(8px) scale(.99)

@keyframes appCardEnter
    0%
        opacity 0
        transform translateY(10px)
    100%
        opacity 1
        transform translateY(0)

