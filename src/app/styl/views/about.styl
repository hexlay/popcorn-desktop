.about-container
    z-index 14
    height 100%
    width 100%
    position fixed
    background-color $BgColor1
    -webkit-user-select none
    opacity 1
    background-image url('../images/bg-header.jpg')
    background-size cover
    background-position 50% 50%
    display flex
    flex-direction column
    align-items center
    justify-content center
    box-sizing border-box
    padding $TitleHeight + 42px 8vw 58px

    .close-icon
        top $TitleHeight + 22px
        right 34px
        width 38px
        height 38px
        border-radius 50%
        background rgba(255,255,255,0.08)
        border 1px solid rgba(255,255,255,0.10)
        color rgba(255,255,255,0.78)
        font-size 17px
        line-height 38px
        padding 0
        display flex
        align-items center
        justify-content center
        box-sizing border-box
        text-align center
        -webkit-backdrop-filter blur(16px) saturate(145%)
        backdrop-filter blur(16px) saturate(145%)
        transition color 180ms ease, background-color 180ms ease, transform 180ms ease

        &:hover
            color #fff
            background rgba(255,255,255,0.13)
            transform translateY(-1px)

    .margintop
        display none

    .icon-title
        opacity 0.9
        margin 0 auto -12px auto
        height 112px
        max-height 112px
        display block
        position relative
        z-index 1
        filter drop-shadow(0 18px 42px rgba(0,0,0,0.48))

    .overlay-content
        height 100%
        width 100%
        position absolute
        top 0
        left 0
        background radial-gradient(circle at 50% 30%, rgba(244,185,66,0.10), transparent 28%), linear-gradient(180deg, rgba(7,10,16,0.38), rgba(3,5,9,0.70)), rgba(0,0,0,0.40)
        -webkit-backdrop-filter blur(2px) saturate(115%)
        backdrop-filter blur(2px) saturate(115%)
        z-index -1

    .content
        margin 0 auto
        width 100%
        max-width 760px
        height auto
        box-sizing border-box
        padding 46px 42px 34px
        border 1px solid rgba(255,255,255,0.10)
        border-radius 18px
        background rgba(255,255,255,0.055)
        box-shadow 0 22px 56px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.06)
        -webkit-backdrop-filter blur(28px) saturate(150%)
        backdrop-filter blur(28px) saturate(150%)
        color #fff
        font-weight 100
        font-family $Font, $AlternateFont
        font-size 17px
        text-align center
        animation appSurfaceEnter $AppMotionNormal $AppMotionEase both

        .title-issue
            a
                color #fff
                font-family $AlternateFont
                font-size 15px
                text-decoration none

                &:hover
                    color $ButtonBgHover
                    text-decoration none

        .title-big
            font-size 2.4em
            position absolute

        .title-version
            position fixed
            right 18px
            bottom 14px
            font-size 11px
            color rgba(255,255,255,0.72)
            z-index 1

            a
                cursor pointer
                color rgba(255,255,255,0.78)
                margin -3px -2px
                padding 3px
                text-decoration none
                &:hover
                    color #fff

            .valid-tick
                width 14px

                &:before
                    content "\2714"
                    font-family Arial
                    font-size 15px
                    font-weight bold
                    text-shadow 0 0 10px #4EEE30
                    color #4EEE30

            .invalid-cross
                width 14px

                &:before
                    content "\2573"
                    font-family Arial
                    font-size 12px
                    font-weight bolder
                    text-shadow 0 0 10px #EE3030
                    color #EE3030

        .text-about
            line-height 1.45
            text-align center
            text-align-last center
            margin 20px auto 34px
            max-width 42em
            font-size 1em
            color rgba(255,255,255,0.82)

            .full-text
                height auto

            br
                line-height 2

        .icons_social
            position static
            display flex
            justify-content center
            align-items center
            gap 12px
            margin 0 0 22px

            a
                width 42px
                height 42px
                display inline-flex
                border-radius 50%
                background-color rgba(255,255,255,0.88)
                box-shadow 0 12px 28px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.50)
                transition opacity 180ms ease, transform 180ms ease, background-color 180ms ease
                margin 0
                background-size 24px 24px !important

                &:hover
                    opacity 1
                    transform translateY(-1px)
                    background-color #fff

            a.site_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-popcorn.png) no-repeat center

            a.ci_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-ci.png) no-repeat center

            a.github_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-github.png) no-repeat center

            a.blog_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-blog.png) no-repeat center

            a.forum_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-discourse.png) no-repeat center

            a.reddit_icon
                background rgba(255,255,255,0.88) url(../images/icons/icon-reddit.png) no-repeat center

        .last-line
            color rgba(255,255,255,0.74)
            font-family $Font, $AlternateFont
            font-size 14px
            position static

            .heart
                color #e74c3c

    .changelog-overlay
        background rgba(4,6,10,0.72)
        display none
        position fixed
        top 0px
        width 100vw
        height 100vh
        z-index 2
        -webkit-backdrop-filter blur(18px) saturate(145%)
        backdrop-filter blur(18px) saturate(145%)

        .title
            font-size 24px
            padding 0
            margin 9vh auto 18px
            color #fff
            font-family $MainFontBold, $AlternateFont
            text-align center

        .changelog-text
            color rgba(255,255,255,0.82)
            text-align left
            font-family $Font, $AlternateFont
            width calc(100% - 80px)
            max-width 860px
            height 70vh
            margin 0 auto
            padding 24px 28px
            box-sizing border-box
            border 1px solid rgba(255,255,255,0.10)
            border-radius 18px
            background rgba(255,255,255,0.055)
            box-shadow 0 22px 56px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.06)
            scrollable()

    @media (max-width: 820px)
        padding-left 22px
        padding-right 22px

        .content
            padding 40px 26px 28px

            .title-version
                position static
                margin-top 20px

        .icon-title
            height 92px
