.item
    display inline-block
    margin 0
    float left
    width 178px
    font-size 0.8em
    padding 0
    border-radius 10px
    overflow hidden
    background linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.025))
    border 1px solid rgba(255,255,255,0.09)
    box-shadow 0 16px 36px rgba(0,0,0,0.30)
    transform-origin center bottom
    contain layout paint style
    content-visibility auto
    contain-intrinsic-size 178px 328px
    animation appCardEnter $AppMotionNormal $AppMotionEase both
    transition transform 220ms $AppMotionEase, border-color $AppMotionFast ease, box-shadow 220ms $AppMotionEase, background-color $AppMotionFast ease
    &.watched
        opacity 0.74
        border-color rgba(244,185,66,0.42)
        box-shadow 0 18px 46px rgba(0,0,0,0.42), 0 0 0 1px rgba(244,185,66,0.12)

        .cover
            &:after
                content ''
                position absolute
                top 0
                right 0
                bottom 0
                left 0
                z-index 2
                background linear-gradient(180deg, rgba(0,0,0,0.26), rgba(0,0,0,0.46))
                pointer-events none

            &:before
                content '\f06e'
                font-family "Font Awesome 6 Free"
                font-weight 900
                position absolute
                top 12px
                left 12px
                z-index 4
                display flex
                align-items center
                justify-content center
                width 30px
                height 30px
                border-radius 50%
                color #17130c
                background $FilterBarActive
                box-shadow 0 10px 24px rgba(0,0,0,0.42), 0 0 24px rgba(244,185,66,0.26)

            .cover-imgs
                filter grayscale(0.35) saturate(0.72) brightness(0.72)

            .seen-chip
                display inline-flex

        .actions-watched
            color #17130c
            background $FilterBarActive
            border-color rgba(244,185,66,0.72)

    &.watched.selected
        opacity 1
    .cover
        background-image url(../images/posterholder.png)
        background-size 178px 260px
        width 178px
        height 260px
        border-radius 0
        box-shadow none
        cursor pointer
        overflow hidden
        position relative
        transform translateZ(0)
        transition transform 180ms ease, box-shadow 180ms ease, filter 180ms ease

        &.empty
            background-image none

        .cover-imgs
            width 100%
            height 100%
            background-size cover
            background-position center
            transition transform 420ms cubic-bezier(.2,.8,.2,1), filter 260ms ease

        .cover-overlay
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            box-sizing border-box
            background-size cover
            background-position center
            opacity 0
            display none
            pointer-events none
            transition opacity 220ms ease, background 220ms ease

            &.selected
                opacity 1
                display block
                padding 0
                border 0
                border-radius 0

            &img
                position absolute
                left 0

            &.fadein
                opacity 1

            &.cover-info-overlay
              padding 0
              background linear-gradient(180deg, rgba(0,0,0,0.20) 0%, rgba(0,0,0,0.02) 42%, rgba(0,0,0,0.32) 100%)
              border-radius 0

              &.selected
                  background linear-gradient(180deg, rgba(5,7,10,0.12) 0%, rgba(5,7,10,0.00) 42%, rgba(5,7,10,0.40) 100%)

                  &:hover
                      background linear-gradient(180deg, rgba(5,7,10,0.20) 0%, rgba(5,7,10,0.02) 42%, rgba(5,7,10,0.48) 100%)

            .card-play-indicator
                position absolute
                top 50%
                left 50%
                width 64px
                height 64px
                margin -32px 0 0 -32px
                border-radius 50%
                color $FilterBarActive
                background rgba(8,10,14,0.58)
                border 2px solid $FilterBarActive
                box-shadow 0 0 0 0 rgba(244,185,66,0.26), 0 14px 34px rgba(0,0,0,0.52)
                font-size 28px
                line-height 62px
                text-align center
                text-indent 4px
                opacity 0
                transform scale(0.78)
                transition opacity 220ms ease, transform 260ms cubic-bezier(.2,.8,.2,1), box-shadow 260ms ease
                pointer-events none

            .actions-favorites
                position absolute
                top 12px
                right 12px
                color #FFFFFF
                font-size 1.75em
                line-height 1
                -webkit-transition color 180ms ease, opacity 180ms ease, transform 180ms ease
                opacity 0
                text-shadow 0 8px 18px rgba(0,0,0,0.55)
                pointer-events auto

                &.selected
                    color $FavoriteColor
                    opacity 1
                &:hover
                    cursor pointer
                    color $ButtonBgActive
                    opacity 1
                    transform scale(1.08)

            .actions-watched
                position absolute
                top 12px
                left 12px
                color #FFFFFF
                font-size 1.75em
                line-height 1
                -webkit-transition color 180ms ease, opacity 180ms ease, transform 180ms ease
                opacity 0
                text-shadow 0 8px 18px rgba(0,0,0,0.55)
                pointer-events auto

                &:hover
                    cursor pointer
                    color $ButtonBgActive
                    opacity 1
                    transform scale(1.08)

                &.selected
                    opacity 1

            .rating
                background linear-gradient(to bottom, rgba(9,10,13,0) 0%, rgba(9,10,13,0.78) 58%, rgba(9,10,13,0.96) 100%)
                border-radius 0
                bottom 0
                display none
                height auto
                left 0
                margin 0
                padding 22px 10px 9px
                position absolute
                right 0
                text-align left

            .rating-stars
                float left
                margin-top -1px
                font-size 85%

                .rating-star
                    color $FilterBarActive
                    padding-right 0px
                    vertical-align middle

                .rating-star-half
                    color $FilterBarActive
                    width 50%

                .rating-star-half-empty
                    color #a3a5a7
                    vertical-align middle

                .rating-star-empty
                    color #a3a5a7
                    vertical-align middle
                    margin-right 0px

                .rating-star-half-container
                    width 1em
                    height 1em
                    line-height 1em
                    vertical-align middle
                    margin-right 1px

            .rating-value
                font-size 1em
                color #fff
                float right

    &.selected
        > .cover .cover-overlay
            display block
            animation cardOverlayIn 260ms ease both

        transform translateY(-10px) scale(1.035)
        border-color rgba(244,185,66,0.86)
        background linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.035))
        box-shadow 0 28px 68px rgba(0,0,0,0.66), 0 0 0 1px rgba(244,185,66,0.25), 0 0 38px rgba(244,185,66,0.12)

        .cover
            .cover-imgs
                transform scale(1.045)
                filter saturate(1.08) brightness(0.98)

            .cover-info-overlay
                z-index 3
                opacity 1
                will-change transform

                .actions-favorites,
                .actions-watched
                    opacity 0.92

                .card-play-indicator
                    opacity 1
                    transform scale(1)
                    animation cardPlayPulse 1500ms ease-in-out infinite

    .offline-chip
        display none
        position absolute
        right 10px
        bottom 10px
        z-index 5
        align-items center
        height 26px
        padding 0 9px
        border-radius 999px
        color #07140d
        background #46c37b
        font-size 11px
        box-shadow 0 8px 20px rgba(0,0,0,0.42)

        i
            margin-right 5px

    &.offline-available .offline-chip
        display inline-flex
    &:hover
        transform translateY(-5px)
        border-color rgba(244,185,66,0.55)
        box-shadow 0 24px 54px rgba(0,0,0,0.48)

        .cover-imgs
            transform scale(1.02)

    &.selected:hover
        transform translateY(-10px) scale(1.035)
        border-color rgba(244,185,66,0.86)
        box-shadow 0 28px 68px rgba(0,0,0,0.66), 0 0 0 1px rgba(244,185,66,0.25), 0 0 38px rgba(244,185,66,0.12)

    .item-meta
        position relative
        min-height 66px
        padding 9px 70px 9px 12px
        box-sizing border-box
        overflow hidden
        background rgba(10,12,16,0.84)
        border-width 1px 0 0
        border-top 1px solid rgba(255,255,255,0.16)
        isolation isolate

        &:before
            content ''
            position absolute
            top -18px
            right -18px
            bottom -18px
            left -18px
            z-index 0
            background-image var(--poster-bg)
            background-size 178px 260px
            background-position center bottom
            transform translateZ(0)
            opacity 0.30

        &:after
            content ''
            position absolute
            top 0
            right 0
            bottom 0
            left 0
            z-index 0
            background linear-gradient(180deg, rgba(20,22,29,0.82), rgba(6,8,12,0.94))

        > *
            position relative
            z-index 1
            text-shadow 0 1px 3px rgba(0,0,0,0.72)

    .item-actions
        position absolute
        top 8px
        right 10px
        display flex
        gap 8px
        z-index 4

        i
            display inline-flex
            align-items center
            justify-content center
            width 24px
            height 24px
            border-radius 50%
            color rgba(255,255,255,0.64)
            app-glass-control()
            font-size 13px
            line-height 1
            transition color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease

            &:hover
                color #fff
                background rgba(255,255,255,0.12)
                border-color rgba(244,185,66,0.38)
                transform translateY(-1px)

            &.selected
                color $FilterBarActive
                background rgba(244,185,66,0.14)
                border-color rgba(244,185,66,0.36)

    .title
        height auto
        margin 0 0 5px
        color $Text1
        max-width 100%
        overflow hidden
        text-overflow ellipsis
        white-space nowrap
        padding-bottom 1px
        font-family $MainFontBold
        font-size 1em
        letter-spacing -0.01em

        span
            display inline-block
            max-width 100%
            overflow hidden
            text-overflow ellipsis
            vertical-align top

        &:hover span
            max-width none
            animation titleMarquee 5.5s linear infinite alternate

    .title2
        font-size 0.85em
        color $Text1
        height auto
        margin -2px 0 2px
        overflow hidden
        text-overflow ellipsis
        white-space nowrap
        padding-bottom 1px

    .year
        font-size 0.88em
        color $Text3
        display block
        margin 0

    .item-meta-bottom
        display flex
        align-items center
        justify-content space-between
        gap 8px
        margin-top 5px

        &:empty
            display none

    .card-rating
        position absolute
        top 12px
        right 12px
        z-index 3
        height 30px
        padding 7px 12px 0
        box-sizing border-box
        border-radius 999px
        color $Text1
        font-family $MainFontBold
        font-size 12px
        line-height 1
        app-glass-control()

        i
            color $FilterBarActive
            margin-right 6px

    .seen-chip
        display none
        position absolute
        left 12px
        bottom 12px
        z-index 5
        align-items center
        height 28px
        padding 0 10px
        border-radius 999px
        color #17130c
        background $FilterBarActive
        font-family $MainFontBold
        font-size 12px
        box-shadow 0 10px 24px rgba(0,0,0,0.42), 0 0 24px rgba(244,185,66,0.18)

        i
            margin-right 6px

    .seasons
        font-size 0.82em
        color $Text1
        display inline-flex
        align-items center
        height 20px
        float none
        margin 0
        border 1px solid rgba(244,185,66,0.72)
        border-radius 999px
        padding 0 8px
        max-width 96px
        overflow hidden
        text-overflow ellipsis
        white-space nowrap

@keyframes fadeBd
    from
        border-color $PosterHoverOverlayOpq
    to
        border-color $PosterHoverBorder

@keyframes cardOverlayIn
    from
        opacity 0
    to
        opacity 1

@keyframes cardPlayPulse
    0%
        box-shadow 0 0 0 0 rgba(244,185,66,0.30), 0 14px 34px rgba(0,0,0,0.52)
    70%
        box-shadow 0 0 0 12px rgba(244,185,66,0), 0 14px 34px rgba(0,0,0,0.52)
    100%
        box-shadow 0 0 0 0 rgba(244,185,66,0), 0 14px 34px rgba(0,0,0,0.52)

@keyframes titleMarquee
    from
        transform translateX(0)
    to
        transform translateX(calc(-100% + 100px))

.load-more,
.search-more
    position relative
    background-size cover
    background-position center center
    width 178px
    height 318px
    border-radius 10px
    border 1px solid rgba(255, 255, 255, 0.08)
    cursor pointer
    display inline-block
    margin 8px
    float left
    background-color rgba(255,255,255,0.05)
    opacity 1

    &:hover
        border 1px solid $PosterHoverBorder
        -webkit-transition border 400ms ease

        > #overlay
            display block

    > .loading-container
        display none
        margin 0
        position relative
        width 100%
        height 100%

        .ball,
        .ball1
            position absolute
            top 50%
            left 50%
            margin -25px
            -webkit-transform translate(-50%, -50%)
        .ball1
            margin -15px

    .status-loadmore,
    .status-searchmore
        position absolute
        color $Text1
        padding-bottom 10px
        padding-top 16px
        border-radius 2px
        font-family $MainFont, $AlternateFont
        opacity 0.3
        text-align center
        top 50%
        left 50%
        width 90%
        -webkit-transform translate(-50%, -50%)

        #searchtor
            height 2.8em
            padding 5px 0 48px
            font-size 1.4em

            #searchtor_globe
                padding-right 10px

            #searchtor_mag
                top -5px
                padding-left 15px
                -webkit-text-stroke 2px $BgColor1

    #overlay
        background $PosterHoverOverlay
        height 100%
        width 100%
        position absolute
        opacity 0.8
        display none

.ghost
    width 178px
    height 0
    margin 0
