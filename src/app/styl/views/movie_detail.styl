.movie-detail
    display flex
    flex-direction row
    justify-content flex-start
    flex-flow row wrap
    height 100vh
    padding-top $HeaderHeight
    width 100vw
    user-select none
    backface-visibility hidden
    background-color $BgColor1
    position fixed

    .spinner
        position fixed
        width 100%
        height 100%
        background rgba(0, 0, 0, 0.5) center center no-repeat
        pointer-events all
        z-index 10
        display none
        top 0

        .loading-container
            margin 50vh auto 0px
            opacity .8

    .backdrop-overlay
        width 100vw
        height 100vh
        position absolute
        opacity 0.78
        background radial-gradient(circle at 68% 16%, rgba(244,185,66,0.18), transparent 28%), linear-gradient(90deg, rgba(9,10,13,0.96) 0%, rgba(9,10,13,0.76) 42%, rgba(9,10,13,0.90) 100%)

    .backdrop
        width 100vw
        height 100%
        margin-top -64px
        position absolute
        opacity 0
        background-position-x 50%
        background-position-y 50%
        -webkit-filter blur(34px) brightness(0.72) saturate(1.18)
        filter blur(34px) brightness(0.72) saturate(1.18)
        background-repeat no-repeat
        background-size cover

        &.fadein
            transition opacity .3s ease-in
            opacity 1

    .poster-box
        height 75vh
        margin-top 8vh
        width 35vw
        padding-left 4vw

        .mcover-image
            float right
            width 100%
            height 100%
            max-width 50vh
            max-height 75vh
            position relative
            margin-right 1vw
            border-radius 18px
            opacity 0
            backface-visibility hidden
            box-shadow 0 30px 70px rgba(0,0,0,0.64), 0 0 0 1px rgba(255,255,255,0.10)

            &.fadein
                transition opacity .3s ease-in
                opacity 1

    .content-box
        height 75vh
        margin-top 8vh
        width 64.99vw
        padding-right 4vw
        display flex
        justify-content space-between
        flex-direction column

        .meta-container
            height calc(100% - 70px)
            flex 2
            overflow hidden
            padding 26px 28px
            margin-top -20px
            background rgba(16,18,24,0.46)
            border 1px solid rgba(255,255,255,0.10)
            border-radius 24px
            box-shadow 0 28px 70px rgba(0,0,0,0.34)
            -webkit-backdrop-filter blur(24px) saturate(150%)
            backdrop-filter blur(24px) saturate(150%)

            .title
                color #FFF
                position relative
                top -4px
                text-stroke 1px rgba(0,0,0,0.1)
                font-size 42px
                font-family $MainFont
                font-smoothing antialiased
                letter-spacing -0.03em

            .metadatas
                top 15px
                height 20px
                position relative
                display flex
                flex-wrap wrap

                .metaitem, .year, .certification, .show-cast, .movie-imdb-link
                    &:hover ~ .tmdb-link
                        opacity 0.4
                        transition-delay .8s

                .metaitem
                    color rgba(248,248,248,0.88)
                    font-size 12px
                    position relative
                    font-family $MainFontBold
                    text-stroke 1px rgba(0,0,0,0.1)
                    font-smoothing antialiased
                    max-width 29%
                    overflow hidden
                    white-space nowrap
                    text-overflow ellipsis

                    &::before
                        content ""
                        margin 4px 15px 0px 15px
                        position relative
                        display inline-block
                        width 4px
                        float left
                        height 4px
                        border-radius 2px
                        background-color rgba(244,185,66,0.70)

                    &:first-child::before
                        display none

                .show-cast
                    color #f8f8f8
                    font-size 12px
                    position relative
                    font-family "Font Awesome 6 Free"
                    text-stroke 1px rgba(0,0,0,0.1)
                    font-smoothing antialiased
                    cursor pointer

                .tmdb-link
                    padding-left 12px
                    padding-right 6px
                    color #f8f8f8
                    font-size 11px
                    position relative
                    font-family "Font Awesome 6 Free"
                    text-stroke 1px rgba(0,0,0,0.1)
                    font-smoothing antialiased
                    cursor pointer
                    opacity 0
                    transition opacity .3s ease-in
                    transition-delay .2s
                    
                    &:hover
                        opacity 1
                        transition-delay 0s

                    &.disabled
                        &:hover
                            cursor default
                            opacity 0.4

                .year, .certification
                    color #f8f8f8
                    font-size 12px
                    position relative
                    font-family $MainFontBold
                    text-stroke 1px rgba(0,0,0,0.1)
                    font-smoothing antialiased
                    cursor pointer

                .movie-imdb-link
                    margin-top -3px
                    padding-top 3px
                    width 29px
                    height 16px
                    position relative
                    cursor pointer
                    background url(../images/icons/imdb.png) right top no-repeat

                .rating-container
                    .hidden
                        display none

                    .number-container
                        width auto
                        float left
                        font-size 12px
                        font-family $MainFontBold
                        color #FFF
                        cursor pointer
                        z-index 2

                        em
                            font-size 0.8em

                    .star-container
                        width auto
                        float left
                        position relative
                        z-index 2
                        cursor pointer

                        .rating-star
                            color #ffc900
                            font-size 11px
                            padding-right 3px

                        .rating-star-half
                            color #ffc900
                            font-size 11px
                            margin-left -4px
                            padding-right 3px

                        .rating-star-half-empty
                            color #a3a5a7
                            font-size 11px
                            margin-left -4px

                        .rating-star-empty
                            color #a3a5a7
                            font-size 11px
                            padding-right 3px

                        .rating-star-half-container
                            width 1em
                            height 1em
                            line-height 1em
                            margin-top -1px
                            margin-right -1px
                            margin-left 4px

                .status-indicators
                    margin-left auto
                    display flex
                    flex-direction row-reverse
                    margin-right 2%

                    &>*:not(:first-child)
                        margin-right 1em
                        border-radius 50%

                    .health-icon
                        position relative
                        font-size 14px
                        color #737577
                        cursor pointer
                        margin-top -1px
                        border-radius 50%
                        &.Bad
                            color #d53f3f
                        &.Medium
                            color #ece523
                        &.Good
                            color #a3e147
                        &.Excellent
                            color #2ad942

                    .magnet-link
                        position relative
                        top 2px
                        font-size 13px
                        color #DDD
                        cursor pointer
                        margin-top -2px
                        margin-right 12px
                        &:hover
                            color #FFF
                            transition all .5s

                    .source-link
                        position relative
                        font-size 13px
                        color #DDD
                        cursor pointer
                        margin-top -2px
                        margin-right 10px
                        &:hover
                            color #FFF
                            transition all .5s
                        img
                            height 16px

            .overview
                position relative
                max-height 35%
                overflow hidden
                float none
                color rgba(255,255,255,0.86)
                top 25px
                padding-right 2%
                font-family $MainFont
                font-smoothing antialiased
                font-size 14px
                line-height 24px
                text-align left
                text-stroke 1px rgba(0,0,0,0.1)
                backface-visibility hidden
                scrollable()

                span
                    opacity 0.7
                    font-size 90%

                span.cname
                    cursor pointer
                    opacity 1
                    font-size 100%

                span.showall-cast
                    cursor pointer
                    opacity 1
                    font-size 100%

                p.sline
                    line-height 0.6

            #torrent-list
                position relative
                top 48px
                max-height 55%
                margin 0 20px 0 3px
                border-radius 16px
                overflow hidden

                table
                    tr
                        &:hover
                            background rgba(255,255,255,0.10)

                        td
                            color #c3c5c7
                            background none

                            &:nth-child(5)
                                padding-right 20px

                    td.provider
                        width 36px
                        padding-left 10px

                    td.action
                        width 36px
                        padding-left 1px

                        &:hover
                            color #fff
                            transition all .5s

        .play-control
            display flex
            flex-direction row
            justify-content space-between
            white-space nowrap
            height 70px
            line-height 35px
            margin 8px 25px 1px 16px

            .flex-left
                min-width 420px
                margin-right -15px

            .setup-container
                display flex
                flex-direction row
                justify-content space-between
                margin-left -10px

            .toggles-container
                display flex
                flex 2
                padding-bottom 10px

            .favourites-toggle
                cursor pointer
                padding 5px
                padding-left 24px
                float left
                color #FFF
                height 26px
                position relative
                width auto
                font-family $MainFont
                font-smoothing antialiased
                font-size 12px
                line-height 17px
                margin-right 20px

                &:before
                    content "\f004"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color #FFF
                    left 0
                    opacity 1
                    transition opacity 0.5s

                &:after
                    content "\f004"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color $ButtonBgActive
                    left 0
                    opacity 0
                    transition opacity 0.5s

                &:hover
                    &:before
                        opacity 0
                    &:after
                        opacity 1

                &.selected
                    height 18px
                    position relative

                    &:before
                        content "\f004"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 18px
                        color $FavoriteColor
                        left 0
                        opacity 1
                        transition opacity 0.5s

                    &:after
                        content "\f004"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 18px
                        color #FFF
                        left 0
                        opacity 0
                        transition opacity 0.5s

                    &:hover
                        &:before
                            opacity 0
                        &:after
                            opacity 1

            .watched-toggle
                cursor pointer
                padding 5px
                padding-left 28px
                float left
                color #FFF
                height 26px
                position relative
                width auto
                font-family $MainFont
                font-smoothing antialiased
                font-size 12px
                line-height 17px

                &:before
                    content "\f070"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 18px
                    color #FFF
                    left 0
                    opacity 1
                    transform scaleY(0.9)
                    transition opacity 0.5s

                &:after
                    content "\f00c"
                    font-family "Font Awesome 6 Free"
                    font-weight 900
                    position absolute
                    font-size 20px
                    color #299000
                    left 0
                    opacity 0
                    transition opacity 0.5s

                &:hover
                    &:before
                        opacity 0
                    &:after
                        opacity 1

                &.selected
                    &:before
                        content "\f00c"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 20px
                        color #299000
                        left 0
                        opacity 1
                        transition opacity 0.5s

                    &:after
                        content "\f070"
                        font-family "Font Awesome 6 Free"
                        font-weight 900
                        position absolute
                        font-size 18px
                        color #FFF
                        left 0
                        opacity 0
                        transition opacity 0.5s

                    &:hover
                        &:before
                            opacity 0
                        &:after
                            opacity 1

            .show-all-torrents
                position relative
                float left
                font-family $MainFont
                -webkit-font-smoothing antialiased
                font-size 11px
                color #fff
                transition all .2s ease-in, margin 0s
                padding 0 6px
                margin 6px 6px 0 -2px
                border-radius 10px
                height 23px
                line-height 23px
                cursor pointer

                &:hover, &.active
                    color $QualitySelectorText
                    background $QualitySelectorBg

                &.fa-spinner
                    font-family "Font Awesome 6 Free"
                    transition none
                    margin-left 6px
                    color #fff

                    &:hover, &.active
                        background none

            .play-selector
                position relative
                float left

                .startStreaming
                    margin-left 12px
                    margin-right 12px

                    &:after
                        content ''
                        width 70%
                        height 100%
                        top 0
                        left 0
                        position absolute

            .quality-selector
                position relative
                float left
                .sdow-quality
                    line-height normal
                    padding 4px
                    height 35px

                    div
                        cursor pointer
                        float left
                        font-family $MainFont
                        -webkit-font-smoothing antialiased
                        font-size 11px
                        color #fff
                        transition all .2s ease-in
                        padding 4px
                        margin-right 6px
                        margin-top 2px

                    .disabled
                        opacity .3
                        cursor default

                    .active
                        cursor pointer
                        opacity 1
                        color $QualitySelectorText
                        background $QualitySelectorBg
                        border-radius 10px
                        font-family $MainFontBold

            .movie-quality-container
                margin-top 10px
                float left
                position relative
                height 15px
                width 95px
                left 3%
                line-height 1

                .sdow-quality
                    div
                        cursor pointer
                        float left
                        font-family $MainFont
                        font-smoothing antialiased
                        font-size 11px
                        color $ShowText1
                        transition all .2s ease-in
                        padding 4px

                .tooltip
                    width 85px

                .disabled
                    opacity .3
                    cursor default

                .active
                    cursor pointer
                    opacity 1
                    color $QualitySelectorText
                    background $QualitySelectorBg
                    border-radius 10px
                    font-family $MainFontBold

                .switch
                    background transparent
                    border-radius 32px
                    display block
                    height 12px
                    position absolute
                    left 28px
                    width 25px
                    border 2px solid #fff
                    cursor pointer

                    label
                        transition color 0.2s ease
                        width 20px
                        cursor pointer
                        &:nth-of-type(1)
                            left -38px
                            position absolute
                            text-align right

                        &:nth-of-type(2)
                            position absolute
                            right -30px
                            text-align left

                    .tooltip
                        width 130px

                    input
                        height 7px
                        left -27px
                        opacity 0
                        position absolute
                        top -4px
                        width 79px
                        z-index 2
                        cursor pointer
                        &:checked
                            z-index 0
                            & ~ label
                                &:nth-of-type(1)
                                    color $ButtonBgActive

                                &:nth-of-type(2)
                                    color #fff

                            & ~ .toggle
                                left 0px

                        & ~ :checked
                            & ~ label
                                &:nth-of-type(1)
                                    color #fff

                                &:nth-of-type(2)
                                    color $ButtonBgActive

                            & ~ .toggle
                                left 11px

                    .toggle
                        transition left 0.2s ease
                        background $ButtonBgActive
                        border-radius 50%
                        height 10px
                        left -0px
                        position absolute
                        top -1px
                        width 10px

// Modern movie detail composition. Kept as an override layer so the existing
// Marionette regions and player/torrent controls continue to work unchanged.
@keyframes detailPosterEnter
    0%
        opacity 0
        transform translateY(18px) scale(.94)
    70%
        opacity 1
        transform translateY(-2px) scale(1.01)
    100%
        opacity 1
        transform translateY(0) scale(1)

.movie-detail
    display grid
    grid-template-columns minmax(260px, 33vw) 1fr
    grid-template-rows 1fr
    column-gap 34px
    align-items stretch
    padding $HeaderHeight + 46px 58px 42px
    min-height 100vh
    box-sizing border-box
    overflow hidden
    background #080a0f

    .backdrop
        margin-top 0
        height 100vh
        opacity 0
        transform scale(1.04)
        -webkit-filter blur(18px) brightness(0.62) saturate(1.14)
        filter blur(18px) brightness(0.62) saturate(1.14)

        &.fadein
            transition opacity 420ms ease, transform 720ms cubic-bezier(.2,.8,.2,1)
            opacity 1
            transform scale(1.01)

    .backdrop-overlay
        opacity 1
        background radial-gradient(circle at 78% 22%, rgba(244,185,66,0.16), transparent 28%), radial-gradient(circle at 34% 78%, rgba(183,64,45,0.22), transparent 34%), linear-gradient(90deg, rgba(5,7,11,0.96) 0%, rgba(9,10,13,0.74) 42%, rgba(5,7,11,0.90) 100%)

    .close-icon
        top $HeaderHeight + 18px
        right 24px
        z-index 4
        width 38px
        height 38px
        border-radius 50%
        background rgba(255,255,255,0.08)
        border 1px solid rgba(255,255,255,0.10)
        color rgba(255,255,255,0.78)
        font-size 17px
        line-height 38px
        text-align center
        -webkit-backdrop-filter blur(16px) saturate(145%)
        backdrop-filter blur(16px) saturate(145%)

        &:hover
            color #fff
            background rgba(255,255,255,0.13)

    .poster-box
        position relative
        z-index 1
        width 100%
        height calc(100vh - 184px)
        min-height 520px
        margin 0
        padding 0
        display flex
        align-items flex-start
        justify-content center

        .mcover-image
            float none
            width min(100%, 390px)
            height 100%
            max-width none
            max-height none
            margin 0
            object-fit cover
            border-radius 22px
            opacity 0
            transform translateY(18px) scale(.94)
            box-shadow 0 34px 86px rgba(0,0,0,0.70), 0 0 0 1px rgba(255,255,255,0.12), 0 0 42px rgba(244,185,66,0.08)
            transition opacity 360ms ease, transform 420ms cubic-bezier(.2,.8,.2,1), box-shadow 260ms ease

            &.fadein
                opacity 1
                transform translateY(0)
                animation detailPosterEnter 560ms cubic-bezier(.2,.8,.2,1)

            &:hover
                transform translateY(-4px) scale(1.01)
                box-shadow 0 40px 96px rgba(0,0,0,0.74), 0 0 0 1px rgba(244,185,66,0.26), 0 0 42px rgba(244,185,66,0.12)

    .content-box
        position relative
        z-index 1
        width 100%
        height calc(100vh - 184px)
        min-height 520px
        margin 0
        padding 0
        min-width 0
        display flex
        flex-direction column
        gap 18px
        justify-content stretch

        .meta-container
            flex 1 1 auto
            height auto
            min-height 300px
            max-height none
            margin 0
            padding 32px 76px 30px 34px
            overflow auto
            background linear-gradient(135deg, rgba(18,20,27,0.68), rgba(12,14,20,0.46))
            border 1px solid rgba(255,255,255,0.11)
            border-radius 26px
            box-shadow 0 30px 76px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.04)
            -webkit-backdrop-filter blur(30px) saturate(155%)
            backdrop-filter blur(30px) saturate(155%)
            scrollable()

            .title
                top 0
                font-family $MainFontBold
                font-size clamp(34px, 4vw, 56px)
                line-height 1.02
                letter-spacing -0.055em
                margin-bottom 18px

            .metadatas
                top 0
                height auto
                min-height 24px
                align-items center
                gap 10px 0
                margin-bottom 20px

                .metaitem, .year, .certification, .show-cast
                    font-size 13px
                    color rgba(255,255,255,0.78)
                    line-height 20px

                .metaitem
                    max-width 40%

                    &::before
                        margin 8px 12px 0 12px
                        width 4px
                        height 4px

                .movie-imdb-link
                    margin-top 1px

                .rating-container
                    display flex
                    align-items center

                    .star-container
                        .rating-star,
                        .rating-star-half
                            color $FilterBarActive
                            font-size 13px

                        .rating-star-empty,
                        .rating-star-half-empty
                            color rgba(255,255,255,0.36)
                            font-size 13px

                    .number-container
                        font-size 13px

                .status-indicators
                    margin-right 0
                    gap 12px

            .overview
                top 0
                max-height none
                padding 0
                margin 0
                color rgba(255,255,255,0.84)
                font-size 16px
                line-height 1.58
                overflow visible

            #torrent-list
                top 0
                max-height 340px
                margin 26px 0 0
                border 1px solid rgba(255,255,255,0.08)
                background rgba(0,0,0,0.16)
                border-radius 18px
                overflow auto
                scrollable()

                table
                    width 100%

                    tr
                        transition background-color 160ms ease

                        &:hover
                            background rgba(255,255,255,0.08)

                    td
                        padding-top 10px
                        padding-bottom 10px

        .play-control
            flex 0 0 auto
            height auto
            min-height 104px
            margin 0
            padding 18px 20px
            display flex
            align-items center
            justify-content space-between
            gap 20px
            line-height normal
            background linear-gradient(135deg, rgba(18,20,27,0.66), rgba(12,14,20,0.50))
            border 1px solid rgba(255,255,255,0.11)
            border-radius 24px
            box-shadow 0 24px 60px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.04)
            -webkit-backdrop-filter blur(26px) saturate(150%)
            backdrop-filter blur(26px) saturate(150%)

            .flex-left
                min-width 0
                flex 1
                margin-right 0

            .row
                margin 0
                display flex
                align-items center
                gap 12px

            .setup-container
                margin 0 0 12px

            .toggles-container
                gap 14px
                padding-bottom 0

            .favourites-toggle,
            .watched-toggle
                height 24px
                margin 0
                padding-top 3px
                color rgba(255,255,255,0.82)
                font-size 13px

            .play-selector
                float none
                display flex

                .startStreaming
                    margin-left 0
                    margin-right 0

            #watch-trailer
                margin-left 0

            .quality-selector
                float none

                .sdow-quality
                    display flex
                    align-items center
                    gap 4px
                    height auto
                    padding 0

                    div
                        float none
                        margin 0
                        padding 7px 8px
                        border-radius 10px
                        color rgba(255,255,255,0.78)

                    .active
                        color #12100a
                        background $FilterBarActive

            .show-all-torrents
                float none
                margin 0
                height 32px
                line-height 32px
                padding 0 10px
                color rgba(255,255,255,0.82)

            .flex-right
                min-width 245px
                display flex
                flex-direction column
                gap 10px
                align-items flex-end

            .button.dropup
                position relative
                display flex
                align-items center
                height 46px
                min-width 172px
                border-radius 999px
                overflow visible

                #watch-now
                    display flex
                    align-items center
                    justify-content center
                    height 46px
                    min-width 118px
                    padding 0 24px
                    margin 0
                    line-height 46px

                .playerchoice
                    display grid
                    grid-template-columns 22px 0
                    align-items center
                    justify-content center
                    gap 12px
                    width 70px
                    height 46px
                    margin 0
                    padding 0
                    box-sizing border-box
                    border-left 1px solid rgba(55,38,8,0.18)
                    background rgba(70,45,0,0.06)
                    border-radius 0 999px 999px 0
                    transition background-color 160ms ease

                    &:hover
                        background rgba(70,45,0,0.10)

                    &:after
                        display none

                    .imgplayerchoice
                        float none
                        width 21px
                        height 21px
                        margin 0
                        opacity .64
                        filter brightness(0) saturate(100%) invert(9%) sepia(22%) saturate(1079%) hue-rotate(2deg) brightness(96%) contrast(92%)

                    .caret
                        margin 0
                        border-top-color rgba(25,18,7,0.88)

            .dropdown-menu
                opacity 1
                margin 0 0 12px
                padding 10px
                background linear-gradient(135deg, rgba(28,31,39,0.78), rgba(13,15,22,0.66))
                border 1px solid rgba(255,255,255,0.13)
                border-radius 20px
                box-shadow 0 28px 70px rgba(0,0,0,0.52), inset 0 1px 0 rgba(255,255,255,0.05)
                -webkit-backdrop-filter blur(28px) saturate(160%)
                backdrop-filter blur(28px) saturate(160%)

            .playerchoicemenu
                right 0
                bottom 100%
                min-width 250px
                max-width 300px

                .playerchoicetoolbar
                    position static
                    display flex
                    justify-content flex-end
                    gap 8px
                    width auto
                    height auto
                    margin 0 0 8px
                    padding 0
                    background transparent

                    .playerchoicerefresh,
                    .playerchoicehelp
                        position static
                        top auto
                        left auto
                        right auto
                        display inline-flex
                        align-items center
                        justify-content center
                        width 28px
                        height 28px
                        padding 0
                        border-radius 50%
                        color rgba(255,255,255,0.72)
                        background rgba(255,255,255,0.08)
                        opacity 1

                        &:hover
                            color #fff
                            background rgba(244,185,66,0.18)

                > li
                    margin 2px 0

                    > a
                        position relative
                        display block
                        max-width none
                        min-height 38px
                        padding 10px 44px 10px 14px
                        border-radius 13px
                        color rgba(255,255,255,0.86)
                        font-size 15px
                        line-height 20px
                        text-overflow ellipsis
                        overflow hidden
                        white-space nowrap
                        transition background-color 160ms ease, color 160ms ease, transform 160ms ease

                        img
                            right 12px
                            top 50%
                            width 22px
                            height 22px
                            margin-top -11px
                            opacity .9

                        &:hover,
                        &:focus
                            color #fff
                            background rgba(244,185,66,0.18)
                            transform translateX(2px)

            #subs-dropdown,
            #audio-dropdown
                position relative

                .dropup
                    position relative
                    overflow visible

                .dropdown-menu
                    right 0
                    left auto
                    bottom 100%
                    min-width 260px
                    max-width 340px

                .lang-option-list
                    display flex
                    flex-direction column
                    gap 4px
                    margin 0

                    .lang-option
                        display flex
                        align-items center
                        gap 12px
                        min-height 42px
                        padding 8px 12px
                        border-radius 13px
                        color rgba(255,255,255,0.86)
                        cursor pointer
                        transition background-color 160ms ease, color 160ms ease, transform 160ms ease

                        &:hover
                            color #fff
                            background rgba(244,185,66,0.17)
                            transform translateX(2px)

                        .flag
                            flex 0 0 auto
                            width 36px
                            height 27px
                            margin 0
                            border-radius 7px
                            background-size cover
                            background-position center
                            box-shadow 0 8px 22px rgba(0,0,0,0.26)

                        .lang-option-name
                            min-width 0
                            overflow hidden
                            text-overflow ellipsis
                            white-space nowrap
                            font-size 14px

                .lang-dropdown
                    height 38px
                    width 250px
                    padding 0 14px 0 16px
                    box-sizing border-box
                    border-radius 999px
                    background rgba(255,255,255,0.07)
                    border 1px solid rgba(255,255,255,0.10)
                    color rgba(255,255,255,0.82)
                    transition background-color 160ms ease, border-color 160ms ease

                    &:hover
                        background rgba(255,255,255,0.10)
                        border-color rgba(244,185,66,0.24)

                    .lang-name
                        flex 1 1 auto
                        max-width none
                        overflow hidden
                        text-overflow ellipsis
                        white-space nowrap

                    .flag.toggle
                        flex 0 0 auto
                        top auto
                        width 32px
                        height 24px
                        margin 0 10px 0 12px
                        border-radius 6px
                        background-size cover
                        background-position center

                    .caret
                        flex 0 0 auto
                        margin 0

@media (max-width: 1180px)
    .movie-detail
        grid-template-columns 280px 1fr
        column-gap 24px
        padding-left 34px
        padding-right 34px

        .content-box
            .meta-container
                padding 26px 64px 26px 26px

            .play-control
                flex-direction column
                align-items stretch

                .flex-right
                    align-items flex-start
                    min-width 0
