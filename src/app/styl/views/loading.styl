.loading
    position absolute
    z-index 9
    background-color $BgColor1
    -webkit-user-select none
    width 100%
    height 100%
    opacity 1
    overflow hidden
    margin auto
    left 0
    right 0
    box-sizing border-box
    background-image radial-gradient(circle at 18% 0%, rgba(244,185,66,0.10), transparent 34%), radial-gradient(circle at 82% 8%, rgba(58,92,164,0.18), transparent 38%)
    -webkit-backface-visibility hidden

    .minimize-icon
        top $TitleHeight + 22px
        right 34px
        position fixed
        color rgba(255,255,255,0.78)
        font-size 17px
        width 38px
        height 38px
        line-height 38px
        padding 0
        display flex
        align-items center
        justify-content center
        box-sizing border-box
        border-radius 50%
        background rgba(255,255,255,0.08)
        border 1px solid rgba(255,255,255,0.10)
        cursor pointer
        z-index 100
        -webkit-font-smoothing antialiased
        -webkit-backdrop-filter blur(16px) saturate(145%)
        backdrop-filter blur(16px) saturate(145%)
        transition color 180ms ease, background-color 180ms ease, transform 180ms ease

        &:hover
            color #fff
            background rgba(255,255,255,0.13)
            transform translateY(-1px)

    .maximize-icon
        display none
        bottom 20px
        right 20px
        position fixed
        color $CloseButton
        font-size 25px
        cursor pointer
        z-index 100
        background rgba(255,255,255,0.08)
        padding 12px 18px
        opacity 1
        border-radius 18px
        border 1px solid rgba(255,255,255,0.10)
        box-shadow 0 18px 42px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.06)
        -webkit-backdrop-filter blur(24px) saturate(145%)
        backdrop-filter blur(24px) saturate(145%)
        -webkit-font-smoothing antialiased
        transition background 0.2s, color 0.2s, opacity 0.2s

        &:hover
            color $ButtonText
            background rgba(255,255,255,0.13)
            opacity 1

        &.done:hover
            color #fff
            background #27ae60

        & > *
            font-size 12px
            vertical-align top
            line-height 25px

        #maxic
            font-size 18px
            margin-left 10px

    #userISP
        text-decoration underline

    .vpn
        margin-top 20px

    .seed_status
        visibility hidden
        margin-top 18px

    .loading-backdrop
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        background-repeat no-repeat
        background-position-x 50%
        background-position-y 50%
        background-size cover
        -webkit-filter blur(22px) brightness(0.62) saturate(1.12)
        transform scale(1.04)

    .loading-backdrop-overlay
        width 100%
        height 100%
        position absolute
        top 0
        left 0
        opacity 0.65
        background radial-gradient(circle at 50% 44%, rgba(244,185,66,0.08), transparent 24%), linear-gradient(180deg, rgba(3,5,9,0.52), rgba(3,5,9,0.74)), rgba(0,0,0,0.46)

    .state-flex
        height 100%
        display flex
        align-items center
        justify-content center
        box-sizing border-box
        padding 72px 28px

    .state
        color #fff
        font-family $MainFont
        -webkit-font-smoothing antialiased
        text-align center
        width 100%
        max-width 560px
        min-height 360px
        height auto
        z-index 11
        -webkit-backface-visibility hidden
        box-sizing border-box
        padding 30px 34px 34px
        border 1px solid rgba(255,255,255,0.10)
        border-radius 18px
        background rgba(255,255,255,0.055)
        box-shadow 0 22px 56px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.06)
        -webkit-backdrop-filter blur(28px) saturate(150%)
        backdrop-filter blur(28px) saturate(150%)
        animation appSurfaceEnter $AppMotionNormal $AppMotionEase both

        .title
            font-family $MainFontBold
            font-size 18px
            line-height 24px
            padding-bottom 18px
            text-overflow ellipsis
            word-wrap break-word
            display block
            max-width 100%
            color $Text1

        .external-play
            font-size 14px
            font-style italic
            padding-bottom 12px
            visibility hidden
            color rgba(255,255,255,0.72)

        .loading-progressbar
            position relative
            margin 0 auto 24px
            width 100%
            height 8px
            background-color rgba(255,255,255,0.18)
            border-radius 999px
            overflow hidden
            visibility hidden
            box-shadow inset 0 1px 2px rgba(0,0,0,0.32)

            & > div
                background-color $ButtonBgActive
                margin-left -100%
                width 100%
                height 8px
                border-radius 999px
                left 0px
                box-shadow 0 0 18px rgba(244,185,66,0.30)
                animation-name bounce_bar
                animation-duration 3s
                animation-iteration-count infinite
                animation-timing-function linear

        .playing-progressbar
            position relative
            margin-bottom 4px
            margin-top 10px
            height 8px
            background-color rgba(255,255,255,0.18)
            border-radius 999px
            display none
            overflow hidden

            & > div
                background-color $ButtonBgActive
                height 8px
                border-radius 999px
                left 0px

        .player-controls
            text-align center
            margin-left 0
            color $Text1
            font-size 15px
            margin-top 18px
            display none
            i
                cursor pointer
                margin 0 8px
                width 34px
                height 34px
                line-height 34px
                border-radius 50%
                background rgba(255,255,255,0.08)
                border 1px solid rgba(255,255,255,0.10)
                transition background-color 180ms ease, color 180ms ease

                &:hover
                    color #fff
                    background rgba(255,255,255,0.13)

        #rbreak1, #rbreak2, #rbreak3
            line-height 13px

        #cancel-button-vpn
            width 140px!important
            position inherit!important
            display inline-block
            margin-left 5px

        #cancel-button-regular
            margin-top 10px
            font-size 10px
            cursor pointer
            display inline-block
            margin-right 5px

        .vpn
            .heading
                font-size 25px
                margin-bottom 10px
            .subheading
                font-size 15px
                margin-bottom 10px
                line-height 20px
            .flex-map
                display flex
                align-items center
                margin-top 20px
                margin-bottom 20px
                .details
                    padding-left 20px
                    .group
                        margin-bottom 15px
                        display flex
                        text-align left
                        .fixed-width
                            width 140px

            .map
                width 300px
                img
                    border 10px solid #bbb
                    width 100%

        .cancel-button
            z-index 2
            cursor pointer
            width 140px
            height 38px
            line-height 1
            margin 24px auto auto auto
            -moz-border-radius 999px
            -webkit-border-radius 999px
            border-radius 999px
            -moz-background-clip padding
            -webkit-background-clip padding-box
            background-clip padding-box
            background-color $ButtonBg
            border 1px solid rgba(255,255,255,0.12)
            box-shadow 0 12px 28px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.18)
            -webkit-backface-visibility hidden
            transition background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease

            &:hover
                background $ButtonBgHover
                text-decoration none
                transform translateY(-1px)
                box-shadow 0 16px 34px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.18)

            &:active
                box-shadow inset 0 1px 4px rgba(0,0,0,0.6)
                background $ButtonBgActive

            .cancel-button-text
                -webkit-backface-visibility hidden
                position relative
                font-family $MainFont, $Font, $AlternateFont
                -webkit-font-smoothing antialiased
                text-align center
                top 13px
                font-size 12px

        .open-button
            float right
            cursor pointer
            transition opacity .2s
            opacity 0.4
            z-index 10

            &:hover
                opacity 1

            &:active
                opacity 1

            .open-button-text
                -webkit-backface-visibility hidden
                position relative
                color #fff
                font-family $MainFont, $Font, $AlternateFont
                -webkit-font-smoothing antialiased
                text-align center
                top 12px
                font-size 12px

        .loading-info
            width 100%
            max-width 430px
            height auto
            margin auto
            padding 18px 18px 16px
            border-radius 14px
            left 0
            right 0
            background rgba(0,0,0,0.28)
            border 1px solid rgba(255,255,255,0.08)
            box-shadow inset 0 1px 0 rgba(255,255,255,0.04)
            display inline-block
            box-sizing border-box

            .loading-summary
                display flex
                align-items baseline
                justify-content center
                gap 8px

            .download-size
                white-space nowrap

            .text_remaining
                min-height 17px
                margin-top 2px
                color rgba(255,255,255,0.86)
                font-size 12px
                line-height 17px

            .loading-info-rows
                display flex
                flex-direction column
                gap 7px
                margin-top 16px

            .loading-info-row
                display flex
                align-items baseline
                justify-content space-between
                gap 20px
                min-width 0

            &:hover
                > .show-pcontrols,
                > .magnet-icon
                    opacity 0.4
                    transition-delay 0s

                    &:hover
                        opacity 1

                    &:active
                        opacity 1

            .magnet-icon
                float right
                cursor pointer
                transition opacity .3s
                transition-delay .3s
                opacity 0
                margin -1px 1px 0 0

                &:hover
                    opacity 1

            span
                position relative
                color rgba(255,255,255,0.86)
                font-family $MainFont
                -webkit-font-smoothing antialiased
                font-size 12px
                line-height 17px

                &.loading-info-text
                    flex 0 0 auto
                    color rgba(255,255,255,0.62)
                &.value
                    flex 1 1 auto
                    min-width 0
                    text-align right
                    overflow hidden
                    white-space nowrap
                    text-overflow ellipsis

            .text_filename
                cursor pointer

            .show-pcontrols
                float right
                cursor pointer
                transition opacity .3s
                transition-delay .3s
                opacity 0
                margin 2px -1px -4px 0

                &:hover
                    opacity 1

            .buffer_percent
                text-align center
                font-size 15px
                line-height 18px
                color $Text1

        .text_download
            color rgba(255,255,255,0.82)
            font-size 15px
            margin-bottom 0

    .warning-nospace
        display none
        position absolute
        bottom 30px
        width 66%
        left 17%
        text-align center
        color #fff
        .warn
            font-size 13px
        .detail
            opacity .85
            font-size 11px

        &:before
            content '\f071'
            color #FFFF00
            font-family "Font Awesome 6 Free"
            font-weight 900
            font-size 16px
            padding-right 8px

@keyframes bounce_bar
    0%
        margin-left:-100%
    100%
        margin-left:100%
