// OFFICIAL POPCORN-THEME: DARK

//Fonts
    $Font = -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', 'Open Sans'
    $MainFont = -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', 'Open Sans Semibold'
    $MainFontBold = -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', 'Open Sans Bold'
    $AlternateFont = sans-serif
    $ButtonFont = -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', 'Open Sans Semibold'

//Main app
    $BgColor1 = #090a0d
    $BgColor2 = #14161c
    $Text1 = #f7f8fb
    $Text2 = #c7ccd6
    $Text3 = #9ba3b0
    $Text4 = #6f7785
    $TextError = #8b93a1
    $CloseButton = #d8dce4
    $CloseButtonHover = #fff
    $SpinnerColor1 = #f4b942
    $SpinnerColor2 = rgba(244,185,66,0.9)
    $ScrollBarBg = #11141b
    $ScrollBarThumb = rgba(255,255,255,0.28)
    $ScrollBarThumbHover = rgba(255,255,255,0.42)

//Top Bar
    $TitleBarBg = rgba(9,10,13,0.84)
    $TitleBarText = #f7f8fb
    $TbarIconFilter = none
    $FullScreenButton = #aeb5c2
    $FullScreenButtonHover = #fff
    $FilterBarBg = rgba(16,18,24,0.72)
    $FilterBarText = #c7ccd6
    $FilterBarTextHover = #fff
    $FilterBarActive = #f4b942
    $SearchBoxBg = rgba(255,255,255,0.10)
    $DropDownBg = rgba(20,22,28,0.94)
    $DropDownBgHover = rgba(244,185,66,0.12)
    $DropDownTextHover = #fff
    $DropDownText = #c7ccd6
    $DropDownOpacity = 0.98
    $FilterBarIcon = #98a0ad
    $FilterBarIconHover = #f4b942
    $FilterBarIcon-PosterWidth = #858d9a
    $TopBarShadow = 0 18px 44px rgba(0,0,0,0.42)

//$ButtonBg
    $ButtonBg = #f4b942
    $ButtonBgHover = #ffd166
    $ButtonBgActive = #d89d24
    $ButtonBgDisabled = #363a44
    $ButtonBgOk = #27AE60
    $ButtonBgWarning = #F15153
    $ButtonText = #16120a
    $ButtonTextHover = #16120a
    $ButtonImgInvert = 0
    $ButtonRadius = 14px

//Checkbox
    $CheckboxBg = rgba(255,255,255,0.14)
    $CheckboxCheck = #f4b942

//Posters
    $PosterRadius = 16px
    $PosterHoverBorder = rgba(244,185,66,0.78)
    $PosterHoverOverlay = linear-gradient(to bottom, rgba(9,10,13,0.12) 0%, rgba(9,10,13,0.82) 100%)
    $PosterHoverOverlayOpq = rgba(16,18,24,0.92)
    $PosterShadow = 0 18px 38px rgba(0,0,0,0.48)

//TV Series
    $ShowBgColor1 = #090a0d
    $ShowBgColor2 = #14161c
    $EpisodeDetailsBg = rgba(20,22,28,0.82)
    $ShowText1 = #f7f8fb
    $ShowText2 = #a6adba
    $ShowOddHighlight = lighten($ShowBgColor1,58%)
    $ShowOddHighlightOp = 0.05
    $SaisonListText = #fff
    $EpisodeListText = #8d9296
    $EpisodeSelectorBg = rgba(244,185,66,0.18)
    $EpisodeSelectorHover = rgba(255,255,255,0.10)
    $EpisodeSelectorHoverTran = lighten($EpisodeSelectorHover,43%)
    $EpisodeSelectorText = #fff
    $ShowWatchedIcon_false = rgba(#fff,0.2)
    $ShowWatchedIcon_hover = rgba(#fff,0.4)
    $ShowWatchedIcon_true = #fff
    $QualitySelectorBg = rgba(244,185,66,0.88)
    $QualitySelectorText = #16120a

//File selector
    $FileSelectorText = #eee
    $FileSelectorBg = rgba(255, 255, 255, 0.08)
    $FileSelectorShadow = rgba(0, 0, 0, 0.67)

//Settings
    $SettingsCategoriesText = #f4b942
    $SettingsSeparator = rgba(255,255,255,0.10)
    $InputBoxBg = rgba(255,255,255,0.10)
    $InputBoxText = #f7f8fb
    $SettingsText1 = #d7dce5
    $SettingsText2 = #8d95a3
    $SettingsButtonText = #16120a
    $SettingsButtonTextHover = #16120a

// Notifications
    $NotificationText = #fff
    $NotificationInfo = #3498DB
    $NotificationSuccess = #27AE60
    $NotificationWarning = #dbb756
    $NotificationOrange = #f07f53
    $NotificationError = #f15153
    $NotificationBorderColor = #000
    $NotificationBtn = #000
    $NotificationBtnText = #fff
    $NotifAlertBg = #14161c
    $NotifAlertText = #fff

//Misc
    $PngLogo = brightness(1.0)
    $PngLogo_BgColo1 = brightness(1.0)
    $WarningColor = #FFFF00
    $FavoriteColor = #ff5470

//Player
    $PlayerColor = #f4b942

// OFFICIAL POPCORN-THEME: DARK - END

@import 'views/app'
